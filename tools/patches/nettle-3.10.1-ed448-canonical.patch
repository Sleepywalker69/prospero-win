From 10a428d4e9b3e74901d8e74685945dce7e394b0c Mon Sep 17 00:00:00 2001
From: Niels Möller <nisse@lysator.liu.se>
Subject: [PATCH] ed448: reject a nonzero final signature octet

Backport the RFC 8032 signature-canonicality check and Wycheproof tc76
regression from https://github.com/gnutls/nettle/commit/10a428d4e9b3e74901d8e74685945dce7e394b0c
for Nettle 3.10.1. Only the hash-initializer context is adapted to the
release's sha3_256_init name. This fixes acceptance of a noncanonical
encoding; it does not establish arbitrary signature forgery.

Nettle's affected files are LGPL-3.0-or-later OR GPL-2.0-or-later.
The source and its notices are staged with the built library.
---
diff --git a/ed448-shake256-verify.c b/ed448-shake256-verify.c
--- a/ed448-shake256-verify.c
+++ b/ed448-shake256-verify.c
@@ -56,8 +56,10 @@ ed448_shake256_verify (const uint8_t *pub,
 #define scratch_out (scratch + 3*ecc->p.size)
   sha3_256_init (&ctx);
 
-  res = (_eddsa_decompress (ecc,
-			    A, pub, scratch_out)
+  /* By RFC 8032, the final octet of the signature must be always
+     zero. Checked here, and ignored by the internal _eddsa_verify. */
+  res = (signature[ED448_SIGNATURE_SIZE - 1] == 0
+	 && _eddsa_decompress (ecc, A, pub, scratch_out)
 	 && _eddsa_verify (ecc, &_nettle_ed448_shake256, pub, A,
 			   &ctx,
 			   length, msg, signature,
diff --git a/testsuite/ed448-test.c b/testsuite/ed448-test.c
--- a/testsuite/ed448-test.c
+++ b/testsuite/ed448-test.c
@@ -123,6 +123,30 @@ test_one (const char *line)
   free (msg);
 }
 
+/* Subset of test vectors from
+   https://github.com/C2SP/wycheproof/blob/master/testvectors_v1/ed448_test.json */
+static void
+test_wycheproof (void)
+{
+  /* tcId: 76 */
+  struct tstring *pub
+    = SHEX ("419610a534af127f583b04818cdb7f0ff300b025f2e01682bcae33fd691cee03"
+	    "9511df0cddc690ee978426e8b38e50ce5af7dcfba50f704c00");
+  struct tstring *msg = SHEX ("54657374");
+  struct tstring *sig /* Final octet should be zero, but isn't. */
+    = SHEX ("5d053ff5b71f6ec3284525d35d77933178c8e19879886d08eccc6c7d27e9e5b5"
+	    "e02537dbc4d4723506e8d171fc1733857573dd02d18f48f280"
+	    "31d67d699a188a9ca46b4eabe2107aef237ca609cb462e24c91d25d286402b6e"
+	    "f7862b78a386950246ff38d6d2f458136d12e3c97fdd982601");
+  ASSERT (pub->length == ED448_KEY_SIZE);
+  ASSERT (sig->length == ED448_SIGNATURE_SIZE);
+
+  ASSERT (!ed448_shake256_verify (pub->data, msg->length, msg->data, sig->data));
+  /* Should verify when last octet is set to zero. */
+  sig->data[ED448_SIGNATURE_SIZE - 1] = 0;
+  ASSERT (ed448_shake256_verify (pub->data, msg->length, msg->data, sig->data));
+}
+
 #ifndef HAVE_GETLINE
 static ssize_t
 getline(char **lineptr, size_t *n, FILE *f)
@@ -247,5 +271,7 @@ test_main(void)
 		""
 		""
 		":");
+
+      test_wycheproof ();
     }
 }
