diff --git a/include/wine/pw_focus_cohort.h b/include/wine/pw_focus_cohort.h
new file mode 100644
index 0000000..1a948ed
--- /dev/null
+++ b/include/wine/pw_focus_cohort.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_FOCUS_COHORT_H
+#define PW_FOCUS_COHORT_H
+/* Numeric constant-return markers allow exact static and runtime comparison.
+ * No pointer returned by the other module is dereferenced. */
+static inline int pw_focus_cohort_matches(void *module, void *(*lookup)(void *, const char *))
+{
+    static const char *const names[] = {"__wine_ps5_focus_abi", "__wine_ps5_focus_protocol", "__wine_ps5_focus_mode", "__wine_ps5_focus_source_0", "__wine_ps5_focus_source_1", "__wine_ps5_focus_source_2", "__wine_ps5_focus_source_3", "__wine_ps5_focus_source_4", "__wine_ps5_focus_source_5", "__wine_ps5_focus_source_6", "__wine_ps5_focus_source_7"};
+    static const unsigned values[] = {1u, 963u, 1u, PW_FOCUS_SOURCE_WORD_0, PW_FOCUS_SOURCE_WORD_1, PW_FOCUS_SOURCE_WORD_2, PW_FOCUS_SOURCE_WORD_3, PW_FOCUS_SOURCE_WORD_4, PW_FOCUS_SOURCE_WORD_5, PW_FOCUS_SOURCE_WORD_6, PW_FOCUS_SOURCE_WORD_7};
+    unsigned i;
+    if (!module || !lookup) return 0;
+    for (i = 0; i < sizeof(values)/sizeof(values[0]); ++i)
+    {
+        unsigned (*marker)(void) = (unsigned (*)(void))lookup(module, names[i]);
+        if (!marker || marker() != values[i]) return 0;
+    }
+    return 1;
+}
+#endif
