+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_FOCUS_PROTOCOL_H
+#define PW_FOCUS_PROTOCOL_H
+#include <stdint.h>
+#include <stddef.h>
+#define PW_FOCUS_ABI 1u
+#define PW_FOCUS_PROTOCOL 963u
+#define PW_FOCUS_CLOCK_MONOTONIC_MS 1u
+#define PW_FOCUS_NATIVE_MAX_LEASE_MS 6000u
+#define PW_FOCUS_MODE_NEUTRAL 1u
+#define PW_FOCUS_MODE_HOST_PROOF 2u
+#define PW_FOCUS_QUIESCE 1u
+#define PW_FOCUS_POLL 2u
+#define PW_FOCUS_ACK_RESULT 3u
+#define PW_FOCUS_SETTLE 4u
+#define PW_FOCUS_CLOSE 5u
+#define PW_FOCUS_ABANDON 6u
+#define PW_FOCUS_KEYBOARD 1u
+#define PW_FOCUS_RECEIPT_PHASE(value) ((value) & 0xffu)
+#define PW_FOCUS_RECEIPT_DISPOSITION(value) (((value) >> 8) & 0xffu)
+#define PW_FOCUS_RECEIPT_RESERVED_MASK 0xffff0000u
+/* Same-address-space native ABI, never a wire record. The provider is trusted
+ * native code installed before server startup; guest requests cannot install it.
+ * Snapshot is bounded, nonblocking, allocation-free and non-reentrant. It must
+ * independently resolve authority; copying the query is not authentication. */
+typedef struct {
+    uint64_t generation;
+    uint32_t native_pid, wine_pid, domain, joined;
+} PwFocusNativeQuery;
+typedef struct {
+    uint64_t snapshot_sequence, session, generation, epoch, expires, user_generation;
+    uint32_t abi, bytes, native_pid, wine_pid, domain, joined, hwnd, frame_ready;
+    uint32_t mode, clock_domain, reserved[2];
+} PwFocusNativeSnapshot;
+typedef struct {
+    uint32_t abi, bytes, protocol, mode, clock_domain, reserved;
+    char source_sha256[65];
+    void *context;
+    int (*snapshot)(void *, const PwFocusNativeQuery *, PwFocusNativeSnapshot *);
+} PwFocusNativeProvider;
+int pw_wineserver_focus_install(const PwFocusNativeProvider *);
+unsigned int __wine_ps5_focus_abi(void);
+unsigned int __wine_ps5_focus_protocol(void);
+unsigned int __wine_ps5_focus_mode(void);
+const char *__wine_ps5_focus_source(void);
+#endif
