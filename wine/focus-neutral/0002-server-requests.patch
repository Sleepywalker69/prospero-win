diff --git a/server/pw_focus_requests.c b/server/pw_focus_requests.c
new file mode 100644
index 0000000..853b6ed
--- /dev/null
+++ b/server/pw_focus_requests.c
@@ -0,0 +1,459 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Optional matched server request boundary. No native routing or USER receipt
+ * consumer is installed here. Generic Wine framing remains unchanged. */
+#include "config.h"
+#include <stdint.h>
+#include <stddef.h>
+#include <limits.h>
+#include <string.h>
+#include <stdatomic.h>
+#include <time.h>
+#include "ntstatus.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "file.h"
+#include "process.h"
+#include "thread.h"
+#include "request.h"
+#include "user.h"
+#include "pw_focus_requests.h"
+#include "wine/pw_focus_protocol.h"
+
+_Static_assert(CHAR_BIT == 8 && sizeof(unsigned int) == 4 && sizeof(uint64_t) == 8, "focus widths");
+_Static_assert(sizeof(struct focus_open_request) == 64, "focus OPEN request");
+_Static_assert(sizeof(struct focus_open_reply) == 64, "focus OPEN reply");
+_Static_assert(sizeof(struct focus_control_request) == 64, "focus CONTROL request");
+_Static_assert(sizeof(struct focus_control_reply) == 64, "focus CONTROL reply");
+_Static_assert(sizeof(struct focus_input_request) == 64, "focus INPUT request");
+_Static_assert(offsetof(struct focus_open_request, session) == 24, "focus OPEN offset");
+_Static_assert(offsetof(struct focus_control_request, cookie) == 24, "focus CONTROL offset");
+_Static_assert(offsetof(struct focus_control_reply, cookie) == 16, "focus receipt offset");
+_Static_assert(offsetof(struct focus_input_request, cookie) == 24, "focus INPUT offset");
+_Static_assert(offsetof(struct focus_control_reply, desktop_serial) == 48, "full 64-bit serial");
+_Static_assert(offsetof(struct focus_control_reply, key_edge) == 56, "key/edge offset");
+_Static_assert(offsetof(struct focus_control_reply, hook_error) == 60, "hook error offset");
+_Static_assert(SERVER_PROTOCOL_VERSION == PW_FOCUS_PROTOCOL, "matched focus protocol");
+
+#ifdef PW_FOCUS_SERVER_REQUESTS
+#if !defined(PW_FOCUS_SERVER_ADAPTER) || !defined(PW_WINE_SERVICE_FIXTURE) || !defined(WINE_INPROCESS_SERVER)
+#error focus requests require the matched adapter, fixture and in-process cohort
+#endif
+#if !defined(__BYTE_ORDER__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error focus cohort requires little-endian wire
+#endif
+#include "pw_focus_adapter.h"
+#include "wine/pw_focus_build.h" /* source-selected generated build evidence */
+_Static_assert(sizeof(PW_FOCUS_BUILD_SOURCE_SHA256) == 65, "source SHA256 encoding");
+_Static_assert(PW_FOCUS_BUILD_MODE == PW_FOCUS_MODE_NEUTRAL ||
+               PW_FOCUS_BUILD_MODE == PW_FOCUS_MODE_HOST_PROOF, "focus mode");
+
+/* Installation uses atomics only before server startup. All remaining state is
+ * confined to Wine's serialized server domain; callbacks may not reenter it. */
+enum { FOCUS_EMPTY, FOCUS_INSTALLING, FOCUS_READY, FOCUS_STARTED, FOCUS_DISABLED };
+static atomic_uint focus_install_state;
+static PwFocusNativeProvider focus_provider;
+static unsigned int focus_snapshot_busy, focus_disabling;
+static uint64_t focus_last_clock;
+static unsigned int focus_clock_valid;
+static struct timeout_user *focus_watchdog;
+struct focus_registration {
+    struct thread *consumer;
+    uint64_t session, generation, epoch, user_generation, snapshot_sequence;
+    user_handle_t hwnd;
+    unsigned int domain;
+};
+static struct focus_registration focus_registrations[PW_FOCUS_CONTEXTS];
+static struct focus_registration *focus_opening;
+
+unsigned int DECLSPEC_EXPORT __wine_ps5_focus_abi(void) { return PW_FOCUS_ABI; }
+unsigned int DECLSPEC_EXPORT __wine_ps5_focus_protocol(void) { return SERVER_PROTOCOL_VERSION; }
+unsigned int DECLSPEC_EXPORT __wine_ps5_focus_mode(void) { return PW_FOCUS_BUILD_MODE; }
+const char * DECLSPEC_EXPORT __wine_ps5_focus_source(void) { return PW_FOCUS_BUILD_SOURCE_SHA256; }
+
+int DECLSPEC_EXPORT pw_wineserver_focus_install(const PwFocusNativeProvider *provider)
+{
+#if PW_FOCUS_BUILD_MODE == PW_FOCUS_MODE_NEUTRAL
+    (void)provider;
+    return -1;
+#else
+    unsigned int empty = FOCUS_EMPTY, installing = FOCUS_INSTALLING;
+    if (!provider || provider->abi != PW_FOCUS_ABI || provider->bytes != sizeof(*provider) ||
+        provider->protocol != SERVER_PROTOCOL_VERSION || provider->mode != PW_FOCUS_BUILD_MODE ||
+        provider->mode != PW_FOCUS_MODE_HOST_PROOF ||
+        provider->clock_domain != PW_FOCUS_CLOCK_MONOTONIC_MS || provider->reserved ||
+        memcmp(provider->source_sha256, PW_FOCUS_BUILD_SOURCE_SHA256, 65) ||
+        !provider->context || !provider->snapshot) return -1;
+    if (!atomic_compare_exchange_strong_explicit(&focus_install_state, &empty, FOCUS_INSTALLING,
+                                                 memory_order_acq_rel, memory_order_acquire)) return -1;
+    focus_provider = *provider;
+    /* Startup may seal an incomplete installation. Never overwrite its refusal. */
+    return atomic_compare_exchange_strong_explicit(&focus_install_state, &installing, FOCUS_READY,
+                                                   memory_order_acq_rel, memory_order_acquire) ? 0 : -1;
+#endif
+}
+
+static void focus_retire(unsigned int slot)
+{
+    struct thread *thread = focus_registrations[slot].consumer;
+    memset(&focus_registrations[slot], 0, sizeof(focus_registrations[slot]));
+    if (thread) release_object(thread);
+}
+
+static void focus_sweep(void)
+{
+    unsigned int slot;
+    for (slot = 0; slot < PW_FOCUS_CONTEXTS; ++slot)
+        if (focus_registrations[slot].consumer && !pw_focus_server_core.contexts[slot].registry)
+            focus_retire(slot);
+}
+
+static void focus_disable(void)
+{
+    unsigned int slot;
+    atomic_store_explicit(&focus_install_state, FOCUS_DISABLED, memory_order_release);
+    if (focus_disabling) return;
+    focus_disabling = 1;
+    if (focus_watchdog) { remove_timeout_user(focus_watchdog); focus_watchdog = NULL; }
+    if (pw_focus_server_core.initialized)
+        for (slot = 0; slot < PW_FOCUS_CONTEXTS; ++slot)
+        {
+            PwFocusContext *context = &pw_focus_server_core.contexts[slot];
+            if (context->cookie) pw_focus_queue_abandon(slot, context->cookie, context->epoch);
+        }
+    focus_sweep();
+    focus_disabling = 0;
+}
+
+int pw_focus_requests_clock(uint64_t *out)
+{
+    struct timespec ts;
+    uint64_t value, part;
+    if (!out || atomic_load_explicit(&focus_install_state, memory_order_acquire) != FOCUS_STARTED ||
+        clock_gettime(CLOCK_MONOTONIC, &ts) || ts.tv_sec < 0 || ts.tv_nsec < 0 || ts.tv_nsec >= 1000000000 ||
+        (uint64_t)ts.tv_sec > (UINT64_MAX - 6000) / 1000) goto failed;
+    value = (uint64_t)ts.tv_sec * 1000;
+    part = (uint64_t)ts.tv_nsec / 1000000;
+    if (part > UINT64_MAX - 6000 - value) goto failed;
+    value += part;
+    if (focus_clock_valid && value < focus_last_clock) goto failed;
+    focus_clock_valid = 1;
+    focus_last_clock = value;
+    *out = value;
+    return 1;
+failed:
+    focus_disable();
+    return 0;
+}
+
+static struct focus_registration *focus_binding(struct process *process)
+{
+    unsigned int slot;
+    if (focus_opening && focus_opening->consumer->process == process) return focus_opening;
+    for (slot = 0; slot < PW_FOCUS_CONTEXTS; ++slot)
+        if (focus_registrations[slot].consumer && pw_focus_server_core.contexts[slot].registry &&
+            focus_registrations[slot].consumer->process == process) return &focus_registrations[slot];
+    return NULL;
+}
+
+static int focus_permit(void *opaque, void *object, PwFocusPermit *out)
+{
+    struct process *process = object;
+    struct focus_registration *registration = focus_binding(process);
+    PwFocusNativeQuery query;
+    PwFocusNativeSnapshot snapshot = {0};
+    int result;
+    unsigned int saved_error;
+    (void)opaque;
+    if (!registration || registration->consumer->state != RUNNING || process->is_terminating ||
+        process->unix_pid <= 0 || focus_snapshot_busy ||
+        atomic_load_explicit(&focus_install_state, memory_order_acquire) != FOCUS_STARTED) return -1;
+    query = (PwFocusNativeQuery){process->fixture_generation, (uint32_t)process->unix_pid,
+                                 process->id, process->fixture_generation ? PW_FOCUS_CHILD : PW_FOCUS_ROOT,
+                                 process->fixture_joined};
+    saved_error = get_error();
+    focus_snapshot_busy = 1;
+    result = focus_provider.snapshot(focus_provider.context, &query, &snapshot);
+    focus_snapshot_busy = 0;
+    if (get_error() != saved_error) { focus_disable(); return -1; }
+    if (result || atomic_load_explicit(&focus_install_state, memory_order_acquire) != FOCUS_STARTED ||
+        snapshot.abi != PW_FOCUS_ABI || snapshot.bytes != sizeof(snapshot) ||
+        !snapshot.snapshot_sequence || (snapshot.snapshot_sequence & 1) ||
+        snapshot.snapshot_sequence < registration->snapshot_sequence ||
+        snapshot.session != registration->session || snapshot.generation != registration->generation ||
+        snapshot.epoch != registration->epoch || snapshot.native_pid != query.native_pid ||
+        snapshot.wine_pid != query.wine_pid || snapshot.domain != registration->domain ||
+        snapshot.domain != query.domain || snapshot.generation != query.generation ||
+        snapshot.joined != query.joined || (query.domain == PW_FOCUS_CHILD && query.joined != 1) ||
+        snapshot.hwnd != registration->hwnd || snapshot.user_generation != registration->user_generation ||
+        snapshot.frame_ready != 1 || snapshot.expires <= focus_last_clock ||
+        snapshot.expires - focus_last_clock > PW_FOCUS_NATIVE_MAX_LEASE_MS ||
+        snapshot.mode != PW_FOCUS_BUILD_MODE ||
+        snapshot.clock_domain != PW_FOCUS_CLOCK_MONOTONIC_MS || snapshot.reserved[0] || snapshot.reserved[1]) return -1;
+    registration->snapshot_sequence = snapshot.snapshot_sequence;
+    *out = (PwFocusPermit){{snapshot.session, snapshot.generation, snapshot.native_pid,
+                            snapshot.wine_pid, snapshot.domain}, snapshot.epoch, snapshot.expires,
+                           process, snapshot.joined, snapshot.frame_ready};
+    return 0;
+}
+
+static void *focus_pin(void *opaque, void *object)
+{ (void)opaque; return grab_object(object); }
+static void focus_unpin(void *opaque, void *object)
+{ (void)opaque; release_object(object); }
+
+void pw_focus_requests_init(void)
+{
+    unsigned int ready = FOCUS_READY;
+    PwFocusCallbacks callbacks = {NULL, focus_permit, focus_pin, focus_unpin, pw_focus_window_live};
+    uint64_t now;
+    if (!atomic_compare_exchange_strong_explicit(&focus_install_state, &ready, FOCUS_STARTED,
+                                                 memory_order_acq_rel, memory_order_acquire))
+    {
+        /* A second startup must not revoke a running instance. */
+        if (ready != FOCUS_STARTED) atomic_store_explicit(&focus_install_state, FOCUS_DISABLED, memory_order_release);
+        return;
+    }
+    if (pw_focus_init(&pw_focus_server_core, &callbacks) || !pw_focus_requests_clock(&now)) focus_disable();
+}
+
+static int focus_has_work(void)
+{
+    unsigned int slot;
+    for (slot = 0; slot < PW_FOCUS_CONTEXTS; ++slot)
+        if (focus_registrations[slot].consumer) return 1;
+    return 0;
+}
+static void focus_watchdog_tick(void *opaque);
+static int focus_arm(void)
+{
+    if (focus_watchdog) return 1;
+    focus_watchdog = add_timeout_user(-(timeout_t)100 * 10000, focus_watchdog_tick, NULL);
+    return focus_watchdog != NULL;
+}
+static void focus_watchdog_tick(void *opaque)
+{
+    uint64_t now;
+    (void)opaque;
+    focus_watchdog = NULL;
+    if (!pw_focus_requests_clock(&now)) return;
+    pw_focus_queue_watchdog();
+    focus_sweep();
+    if (focus_has_work() && !focus_arm()) focus_disable();
+}
+
+void pw_focus_requests_thread_dead(struct thread *thread)
+{
+    unsigned int slot;
+    for (slot = 0; slot < PW_FOCUS_CONTEXTS; ++slot)
+        if (focus_registrations[slot].consumer == thread)
+        {
+            PwFocusContext *context = &pw_focus_server_core.contexts[slot];
+            pw_focus_queue_abandon(slot, context->cookie, context->epoch);
+            focus_retire(slot);
+        }
+    if (!focus_has_work() && focus_watchdog) { remove_timeout_user(focus_watchdog); focus_watchdog = NULL; }
+}
+void pw_focus_requests_process_dead(struct process *process)
+{
+    unsigned int slot;
+    for (slot = 0; slot < PW_FOCUS_CONTEXTS; ++slot)
+        if (focus_registrations[slot].consumer && focus_registrations[slot].consumer->process == process)
+            pw_focus_requests_thread_dead(focus_registrations[slot].consumer);
+}
+
+static void focus_refuse(unsigned int status)
+{
+    /* No kill, signal, FD close or fabricated settlement on a focus refusal. */
+    if (current) pw_focus_requests_thread_dead(current);
+    set_error(status);
+}
+static int focus_header(unsigned int abi)
+{
+    if (focus_snapshot_busy) { focus_disable(); set_error(STATUS_INVALID_PARAMETER); return 0; }
+    if (!current || current->state != RUNNING || current->process->is_terminating ||
+        abi != PW_FOCUS_ABI || get_req_data_size() || get_reply_max_size() || focus_snapshot_busy ||
+        atomic_load_explicit(&focus_install_state, memory_order_acquire) != FOCUS_STARTED)
+    { focus_refuse(STATUS_INVALID_PARAMETER); return 0; }
+    return 1;
+}
+static PwFocusContext *focus_owned(unsigned int slot, uint64_t cookie, uint64_t epoch)
+{
+    PwFocusContext *context;
+    if (slot >= PW_FOCUS_CONTEXTS || focus_registrations[slot].consumer != current) return NULL;
+    context = &pw_focus_server_core.contexts[slot];
+    if (!cookie || context->cookie != cookie || context->epoch != epoch || !context->registry ||
+        context->process != current->process) return NULL;
+    return context;
+}
+
+DECL_HANDLER(focus_open)
+{
+    struct focus_registration registration = {0};
+    struct desktop *desktop;
+    struct window *window;
+    PwFocusServerFacts facts;
+    PwFocusIdentity identity;
+    uint64_t now, generation, cookie;
+    uint32_t slot;
+    int result;
+    if (!focus_header(req->abi)) return;
+    if (req->reserved || !req->session || !req->epoch || !req->user_generation || !req->hwnd ||
+        (req->domain != PW_FOCUS_ROOT && req->domain != PW_FOCUS_CHILD) || current->process->unix_pid <= 0 ||
+        (req->domain == PW_FOCUS_ROOT && (req->generation || current->process->fixture_generation)) ||
+        (req->domain == PW_FOCUS_CHILD && (!req->generation || req->generation != current->process->fixture_generation ||
+                                         current->process->fixture_joined != 1)))
+    { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    if (!pw_focus_requests_clock(&now)) { set_error(STATUS_UNSUCCESSFUL); return; }
+    if (!(desktop = get_thread_desktop(current, 0))) { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    window = pw_focus_pin_window(current->process, desktop, req->hwnd, &generation);
+    if (!window) { release_object(desktop); focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    if (!focus_arm())
+    { release_object(window); release_object(desktop); focus_disable(); set_error(STATUS_NO_MEMORY); return; }
+    registration.consumer = (struct thread *)grab_object(current);
+    registration.session = req->session;
+    registration.generation = req->generation;
+    registration.epoch = req->epoch;
+    registration.user_generation = req->user_generation;
+    registration.hwnd = req->hwnd;
+    registration.domain = req->domain;
+    facts = (PwFocusServerFacts){current->process, current->process->fixture_generation,
+                                 (uint32_t)current->process->unix_pid, current->process->id,
+                                 current->process->fixture_joined};
+    identity = (PwFocusIdentity){req->session, req->generation, facts.native_pid, facts.wine_pid, req->domain};
+    focus_opening = &registration;
+    result = pw_focus_open(&pw_focus_server_core, &identity, req->epoch, &facts, desktop, window,
+                           req->hwnd, generation, now, &slot, &cookie);
+    focus_opening = NULL;
+    release_object(window);
+    release_object(desktop);
+    if (result)
+    {
+        release_object(registration.consumer);
+        if (!focus_has_work() && focus_watchdog) { remove_timeout_user(focus_watchdog); focus_watchdog = NULL; }
+        focus_refuse(STATUS_ACCESS_DENIED);
+        return;
+    }
+    focus_registrations[slot] = registration;
+    if (get_error() || atomic_load_explicit(&focus_install_state, memory_order_acquire) != FOCUS_STARTED)
+    { focus_refuse(STATUS_ACCESS_DENIED); return; }
+    reply->cookie = cookie;
+    reply->epoch = req->epoch;
+    reply->session = req->session;
+    reply->generation = req->generation;
+    reply->native_pid = facts.native_pid;
+    reply->wine_pid = facts.wine_pid;
+    reply->slot = slot;
+    reply->consumer_tid = current->id;
+    reply->server_window_generation = generation;
+}
+
+DECL_HANDLER(focus_control)
+{
+    PwFocusContext *context;
+    PwFocusReceipt receipt = {0};
+    PwFocusPhase phase;
+    uint64_t final_sequence = 0;
+    int result = PW_FOCUS_REFUSED;
+    if (!focus_header(req->abi)) return;
+    context = focus_owned(req->slot, req->cookie, req->epoch);
+    if (!context || req->reserved || req->opcode < PW_FOCUS_QUIESCE || req->opcode > PW_FOCUS_ABANDON ||
+        (req->opcode != PW_FOCUS_ACK_RESULT && req->sequence) ||
+        (req->opcode != PW_FOCUS_ACK_RESULT && req->opcode != PW_FOCUS_SETTLE && req->client_sequence))
+    { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    switch (req->opcode)
+    {
+    case PW_FOCUS_QUIESCE:
+        result = pw_focus_queue_quiesce(req->slot, req->cookie, req->epoch);
+        break;
+    case PW_FOCUS_POLL:
+        result = pw_focus_queue_poll(req->slot, req->cookie, req->epoch, &receipt, &phase);
+        break;
+    case PW_FOCUS_ACK_RESULT:
+        if (context->normal_result)
+        {
+            PwFocusReceipt *retained = &context->operations[context->normal_result - 1].receipt;
+            if (retained->ticket.seq == req->sequence && retained->client_seq == req->client_sequence)
+                result = pw_focus_queue_ack(&retained->ticket);
+        }
+        break;
+    case PW_FOCUS_SETTLE:
+        if (req->client_sequence == context->last_client_seq)
+        { result = pw_focus_queue_settle(req->slot, req->cookie, req->epoch); final_sequence = context->issued; }
+        break;
+    case PW_FOCUS_CLOSE:
+        result = pw_focus_close(&pw_focus_server_core, req->slot, req->cookie, req->epoch);
+        if (!result) focus_retire(req->slot);
+        break;
+    case PW_FOCUS_ABANDON:
+        pw_focus_queue_abandon(req->slot, req->cookie, req->epoch);
+        focus_retire(req->slot);
+        result = 0;
+        break;
+    }
+    if (result || get_error() ||
+        atomic_load_explicit(&focus_install_state, memory_order_acquire) != FOCUS_STARTED ||
+        context->phase > PW_FOCUS_CLOSED || receipt.outcome > PW_FOCUS_MOTION_NO_CHANGE ||
+        receipt.repeat || receipt.down > 1 || receipt.key > 255 ||
+        (receipt.ticket.seq && (!receipt.client_seq || !receipt.outcome || receipt.ticket.cookie != req->cookie ||
+                                receipt.ticket.epoch != req->epoch || receipt.ticket.slot != req->slot)) ||
+        (!receipt.ticket.seq && (receipt.client_seq || receipt.key || receipt.down || receipt.outcome ||
+                                 receipt.hook_error || receipt.desktop_serial)))
+    { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    reply->abi = PW_FOCUS_ABI;
+    reply->phase_disposition = context->phase | (receipt.outcome << 8);
+    reply->cookie = req->cookie;
+    reply->epoch = req->epoch;
+    reply->sequence = receipt.ticket.seq ? receipt.ticket.seq : final_sequence;
+    reply->client_sequence = req->opcode == PW_FOCUS_SETTLE ? context->last_client_seq : receipt.client_seq;
+    reply->desktop_serial = receipt.desktop_serial;
+    reply->key_edge = receipt.key | (receipt.down << 16);
+    reply->hook_error = receipt.hook_error;
+    if (!focus_has_work() && focus_watchdog) { remove_timeout_user(focus_watchdog); focus_watchdog = NULL; }
+}
+
+static unsigned int focus_normalized_key(unsigned int key, unsigned int flags)
+{
+    switch (key)
+    {
+    case VK_MENU: case VK_LMENU: case VK_RMENU:
+        return flags & KEYEVENTF_EXTENDEDKEY ? VK_RMENU : VK_LMENU;
+    case VK_CONTROL: case VK_LCONTROL: case VK_RCONTROL:
+        return flags & KEYEVENTF_EXTENDEDKEY ? VK_RCONTROL : VK_LCONTROL;
+    case VK_SHIFT: case VK_LSHIFT: case VK_RSHIFT:
+        return flags & KEYEVENTF_EXTENDEDKEY ? VK_RSHIFT : VK_LSHIFT;
+    default: return key;
+    }
+}
+DECL_HANDLER(focus_input)
+{
+    PwFocusContext *context;
+    PwFocusTicket ticket;
+    union hw_input input = {0};
+    int result;
+    (void)reply;
+    if (!focus_header(req->abi)) return;
+    context = focus_owned(req->slot, req->cookie, req->epoch);
+    if (!context || req->type != PW_FOCUS_KEYBOARD || !req->code || req->code > 255 || req->x > 255 ||
+        (req->y & ~(KEYEVENTF_KEYUP | KEYEVENTF_EXTENDEDKEY)) || req->down > 1 ||
+        req->down != !(req->y & KEYEVENTF_KEYUP))
+    { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    result = pw_focus_queue_begin(req->slot, req->cookie, req->epoch, req->client_sequence,
+                                  focus_normalized_key(req->code, req->y), req->down, &ticket);
+    if (result) { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+    input.kbd.type = INPUT_KEYBOARD;
+    input.kbd.vkey = req->code;
+    input.kbd.scan = req->x;
+    input.kbd.flags = req->y;
+    result = pw_focus_queue_keyboard(&ticket, context->desktop, context->handle, &input);
+    if (result) focus_refuse(STATUS_ACCESS_DENIED);
+}
+#else
+void pw_focus_requests_init(void) {}
+void pw_focus_requests_thread_dead(struct thread *thread) { (void)thread; }
+void pw_focus_requests_process_dead(struct process *process) { (void)process; }
+int pw_focus_requests_clock(uint64_t *out) { (void)out; return 0; }
+DECL_HANDLER(focus_open) { (void)req; (void)reply; set_error(STATUS_NOT_SUPPORTED); }
+DECL_HANDLER(focus_control) { (void)req; (void)reply; set_error(STATUS_NOT_SUPPORTED); }
+DECL_HANDLER(focus_input) { (void)req; (void)reply; set_error(STATUS_NOT_SUPPORTED); }
+#endif
