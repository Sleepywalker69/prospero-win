+static unsigned int focus_normalized_key(unsigned int key, unsigned int flags)
+{
+    switch (key)
+    {
+    case VK_MENU: case VK_LMENU: case VK_RMENU:
+        return flags & KEYEVENTF_EXTENDEDKEY ? VK_RMENU : VK_LMENU;
+    case VK_CONTROL: case VK_LCONTROL: case VK_RCONTROL:
+        return flags & KEYEVENTF_EXTENDEDKEY ? VK_RCONTROL : VK_LCONTROL;
+    case VK_SHIFT: case VK_LSHIFT: case VK_RSHIFT:
+        return flags & KEYEVENTF_EXTENDEDKEY ? VK_RSHIFT : VK_LSHIFT;
+    default: return key;
+    }
+}
+DECL_HANDLER(focus_input)
+{
+    PwFocusContext *context;
+    PwFocusTicket ticket;
+    union hw_input input = {0};
+    int result;
+    (void)reply;
+    if (!focus_header(req->abi)) return;
+    context = focus_owned(req->slot, req->cookie, req->epoch);
+    if (req->type == PW_FOCUS_MOUSE_BUTTON)
+    {
+        static const unsigned int button_flags[3][2] =
+        {
+            {MOUSEEVENTF_LEFTUP, MOUSEEVENTF_LEFTDOWN},
+            {MOUSEEVENTF_RIGHTUP, MOUSEEVENTF_RIGHTDOWN},
+            {MOUSEEVENTF_MIDDLEUP, MOUSEEVENTF_MIDDLEDOWN}
+        };
+        if (!context || req->code > 2 || req->x || req->y || req->down > 1)
+        { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+        result = pw_focus_queue_begin(req->slot, req->cookie, req->epoch, req->client_sequence,
+                                      256u + req->code, req->down, &ticket);
+        if (result) { focus_refuse(STATUS_INVALID_PARAMETER); return; }
+        input.mouse.type = INPUT_MOUSE;
+        input.mouse.flags = button_flags[req->code][req->down];
+        result = pw_focus_queue_mouse_button(&ticket, context->desktop, context->handle, &input);
+        if (result) focus_refuse(STATUS_ACCESS_DENIED);
+        return;
+    }
     if (!context || req->type != PW_FOCUS_KEYBOARD || !req->code || req->code > 255 || req->x > 255 ||
         (req->y & ~(KEYEVENTF_KEYUP | KEYEVENTF_EXTENDEDKEY)) || req->down > 1 ||
         req->down != !(req->y & KEYEVENTF_KEYUP))
