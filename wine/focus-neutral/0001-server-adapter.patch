+
+int pw_focus_queue_ack(const PwFocusTicket *ticket)
+{
+    PwFocusContext *context = focus_context(ticket);
+    struct desktop *desktop;
+    int result;
+    if (!context || !context->desktop) return PW_FOCUS_BAD_ID;
