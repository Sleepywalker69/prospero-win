diff --git a/server/pw_focus_core.c b/server/pw_focus_core.c
new file mode 100644
index 0000000..0c5ab55
--- /dev/null
+++ b/server/pw_focus_core.c
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_focus_core.h"
+#include <limits.h>
+#include <string.h>
+#define LEASE 6000u
+static int same(const PwFocusIdentity *a,const PwFocusIdentity *b)
+{return a->session==b->session&&a->generation==b->generation&&a->native_pid==b->native_pid&&a->wine_pid==b->wine_pid&&a->domain==b->domain;}
+static int identity_ok(const PwFocusIdentity *i)
+{return i&&i->session&&i->native_pid&&i->wine_pid&&((i->domain==PW_FOCUS_ROOT&&!i->generation)||(i->domain==PW_FOCUS_CHILD&&i->generation));}
+static PwFocusContext *find(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch)
+{if(!c||!c->initialized||n>=PW_FOCUS_CONTEXTS)return NULL;PwFocusContext *x=&c->contexts[n];return cookie&&x->cookie==cookie&&epoch==x->epoch?x:NULL;}
+static void unpin_binding(PwFocusCore *c,PwFocusContext *x)
+{
+    if(x->window)c->callbacks.unpin(c->callbacks.context,x->window);
+    if(x->desktop)c->callbacks.unpin(c->callbacks.context,x->desktop);
+    if(x->process)c->callbacks.unpin(c->callbacks.context,x->process);
+    x->window=x->desktop=x->process=NULL;
+}
+static void drop(PwFocusCore *c,PwFocusContext *x)
+{if(x->refs&&!--x->refs)unpin_binding(c,x);}
+static void timer_off(PwFocusCore *c,PwFocusContext *x)
+{if(x->timer){x->timer=0;x->timer_parent=0;x->timer_key=0;drop(c,x);}}
+static void poison(PwFocusCore *c,PwFocusContext *x,unsigned why)
+{if(!x->poison)x->poison=why?why:1;x->phase=PW_FOCUS_POISONED;timer_off(c,x);}
+static void advance(PwFocusContext *x)
+{if((x->phase==PW_FOCUS_DRAINING||x->phase==PW_FOCUS_RELEASING)&&!x->outstanding&&!x->normal_result)x->phase=PW_FOCUS_RELEASE_READY;}
+static int permit_ok(PwFocusCore *c,PwFocusContext *x,uint64_t now)
+{
+    PwFocusPermit p={0};
+    return now>=x->last_clock&&now<x->lease_deadline&&x->process&&
+        !c->callbacks.permit(c->callbacks.context,x->process,&p)&&
+        p.process==x->process&&same(&p.identity,&x->identity)&&p.epoch==x->epoch&&
+        p.frame_ready==1&&p.expires>now&&
+        (p.identity.domain==PW_FOCUS_ROOT||p.joined==1)&&
+        c->callbacks.window_live(c->callbacks.context,x->process,x->desktop,x->window,x->handle,x->user_generation);
+}
+static int check(PwFocusCore *c,PwFocusContext *x,uint64_t now)
+{
+    if(!x||!x->registry||x->poison||x->phase==PW_FOCUS_CLOSED)return PW_FOCUS_REFUSED;
+    if(!permit_ok(c,x,now)){poison(c,x,1);return PW_FOCUS_REFUSED;}
+    x->last_clock=now;return 0;
+}
+int pw_focus_init(PwFocusCore *c,const PwFocusCallbacks *b)
+{
+    if(!c||c->initialized||!b||!b->permit||!b->pin||!b->unpin||!b->window_live)return PW_FOCUS_REFUSED;
+    memset(c,0,sizeof(*c));c->callbacks=*b;c->next_cookie=1;c->initialized=1;return 0;
+}
+int pw_focus_open(PwFocusCore *c,const PwFocusIdentity *id,uint64_t epoch,const PwFocusServerFacts *actual,void *desktop,void *window,uint64_t handle,uint64_t gen,uint64_t now,uint32_t *slot,uint64_t *cookie)
+{
+    PwFocusPermit p={0};PwFocusContext *x=NULL;uint32_t n;
+    void *process=actual?actual->process:NULL;
+    if(!c||!c->initialized||!identity_ok(id)||!epoch||!process||!desktop||!window||process==desktop||process==window||desktop==window||!handle||!gen||!slot||!cookie||now>UINT64_MAX-LEASE||!c->next_cookie||c->next_cookie==UINT64_MAX)return PW_FOCUS_REFUSED;
+    if(id->native_pid!=actual->native_pid||id->wine_pid!=actual->wine_pid||
+       (id->domain==PW_FOCUS_CHILD&&(id->generation!=actual->fixture_generation||actual->fixture_joined!=1))||
+       (id->domain==PW_FOCUS_ROOT&&actual->fixture_generation))return PW_FOCUS_BAD_ID;
+    if(c->callbacks.permit(c->callbacks.context,process,&p)||p.process!=process||!same(id,&p.identity)||p.epoch!=epoch||p.frame_ready!=1||p.expires<=now||(id->domain==PW_FOCUS_CHILD&&p.joined!=1))return PW_FOCUS_BAD_ID;
+    /* A trusted permit cannot bypass an unsettled server epoch. */
+    for(n=0;n<PW_FOCUS_CONTEXTS;n++)
+        if(c->contexts[n].cookie&&c->contexts[n].phase!=PW_FOCUS_CLOSED)return PW_FOCUS_REFUSED;
+    for(n=0;n<PW_FOCUS_CONTEXTS;n++){
+        PwFocusContext *old=&c->contexts[n];
+        if(old->cookie&&old->identity.session==id->session&&old->identity.domain==id->domain&&old->identity.generation==id->generation){
+            if(!same(&old->identity,id))return PW_FOCUS_BAD_ID;
+            if(old->phase!=PW_FOCUS_CLOSED||old->refs||epoch<=old->epoch)return PW_FOCUS_REFUSED;
+            x=old;break;
+        }
+    }
+    if(!x)for(n=0;n<PW_FOCUS_CONTEXTS;n++)if(!c->contexts[n].cookie){x=&c->contexts[n];break;}
+    if(!x)return PW_FOCUS_LIMIT;
+    void *pp=c->callbacks.pin(c->callbacks.context,process);
+    void *dd=pp?c->callbacks.pin(c->callbacks.context,desktop):NULL;
+    void *ww=dd?c->callbacks.pin(c->callbacks.context,window):NULL;
+    if(pp!=process||dd!=desktop||ww!=window||!c->callbacks.window_live(c->callbacks.context,process,desktop,window,handle,gen)){
+        if(ww)c->callbacks.unpin(c->callbacks.context,ww);
+        if(dd)c->callbacks.unpin(c->callbacks.context,dd);
+        if(pp)c->callbacks.unpin(c->callbacks.context,pp);
+        return PW_FOCUS_REFUSED;
+    }
+    memset(x,0,sizeof(*x));x->identity=*id;x->epoch=epoch;x->cookie=c->next_cookie++;
+    x->process=pp;x->desktop=dd;x->window=ww;x->handle=handle;x->user_generation=gen;
+    x->last_clock=now;x->lease_deadline=now+LEASE;x->registry=x->refs=1;x->phase=PW_FOCUS_ACTIVE;
+    *slot=n;*cookie=x->cookie;return 0;
+}
+int pw_focus_begin(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch,uint64_t seq,uint32_t key,unsigned down,unsigned repeat,uint64_t now,PwFocusTicket *ticket)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);unsigned free_slot=PW_FOCUS_OPS,used=0;
+    if(!ticket||!key||key>PW_FOCUS_KEYS||(key==PW_FOCUS_KEYS&&(down||repeat))||down>1||repeat>1||check(c,x,now))return PW_FOCUS_REFUSED;
+    if(repeat){if(x->phase!=PW_FOCUS_ACTIVE||!x->timer||!down||key>=PW_FOCUS_KEYS||key!=x->timer_key||!x->timer_parent||seq)return PW_FOCUS_REFUSED;}
+    else{
+        if(x->normal_result)return PW_FOCUS_BUSY;
+        for(unsigned i=0;i<PW_FOCUS_OPS;i++)if(x->operations[i].used&&!x->operations[i].receipt.repeat)return PW_FOCUS_BUSY;
+        if(x->last_client_seq==UINT64_MAX||seq!=x->last_client_seq+1){poison(c,x,2);return PW_FOCUS_BAD_ID;}
+        if(x->phase==PW_FOCUS_RELEASE_READY){if(down||key>=PW_FOCUS_KEYS||!x->held[key])return PW_FOCUS_REFUSED;}
+        else if(x->phase!=PW_FOCUS_ACTIVE)return PW_FOCUS_REFUSED;
+    }
+    for(unsigned i=0;i<PW_FOCUS_OPS;i++){if(x->operations[i].used)used++;else if(free_slot==PW_FOCUS_OPS)free_slot=i;}
+    if(x->issued==UINT64_MAX||free_slot==PW_FOCUS_OPS||(repeat&&used>=PW_FOCUS_OPS-1)){
+        poison(c,x,3);return PW_FOCUS_LIMIT;
+    }
+    PwFocusOperation *o=&x->operations[free_slot];memset(o,0,sizeof(*o));o->used=o->pending=1;
+    o->receipt.ticket=(PwFocusTicket){cookie,epoch,++x->issued,n,free_slot};
+    o->receipt.client_seq=seq;o->receipt.parent_seq=repeat?x->timer_parent:0;o->receipt.key=key;o->receipt.down=down;o->receipt.repeat=repeat;
+    x->outstanding++;x->refs++;
+    if(!repeat)x->last_client_seq=seq;
+    if(x->phase==PW_FOCUS_RELEASE_READY)x->phase=PW_FOCUS_RELEASING;
+    *ticket=o->receipt.ticket;return 0;
+}
+static PwFocusOperation *operation(PwFocusCore *c,const PwFocusTicket *t,PwFocusContext **xp)
+{
+    if(!t||t->operation>=PW_FOCUS_OPS)return NULL;
+    PwFocusContext *x=find(c,t->slot,t->cookie,t->epoch);if(!x)return NULL;
+    PwFocusOperation *o=&x->operations[t->operation];
+    if(!o->used||o->receipt.ticket.seq!=t->seq)return NULL;
+    *xp=x;return o;
+}
+int pw_focus_complete(PwFocusCore *c,const PwFocusTicket *t,PwFocusOutcome outcome,uint32_t error,uint64_t serial)
+{
+    PwFocusContext *x;PwFocusOperation *o=operation(c,t,&x);
+    if(!o||!o->pending)return PW_FOCUS_BAD_ID;
+    if(outcome<PW_FOCUS_CLEAN||outcome>PW_FOCUS_MOTION_NO_CHANGE||((outcome==PW_FOCUS_CLEAN||outcome==PW_FOCUS_MOTION_NO_CHANGE)&&error)||(outcome==PW_FOCUS_MOTION_NO_CHANGE&&(o->receipt.key!=PW_FOCUS_KEYS||serial))||(outcome==PW_FOCUS_SUPPRESSED&&error)||(outcome==PW_FOCUS_APPLIED_EXCEPTION&&!error))return PW_FOCUS_REFUSED;
+    o->pending=0;x->outstanding--;o->receipt.outcome=outcome;o->receipt.hook_error=error;o->receipt.desktop_serial=serial;
+    if((outcome==PW_FOCUS_CLEAN||outcome==PW_FOCUS_APPLIED_EXCEPTION)&&o->receipt.key<PW_FOCUS_KEYS)x->held[o->receipt.key]=(unsigned char)o->receipt.down;
+    if(outcome!=PW_FOCUS_CLEAN&&outcome!=PW_FOCUS_MOTION_NO_CHANGE)poison(c,x,4);
+    if(o->receipt.repeat||!x->registry){o->used=0;advance(x);drop(c,x);return 0;}
+    if(x->normal_result){poison(c,x,5);return PW_FOCUS_REFUSED;}
+    x->normal_result=t->operation+1;advance(x);return 0;
+}
+int pw_focus_poll(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch,uint64_t now,PwFocusReceipt *out,PwFocusPhase *phase)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);
+    if(!x||!out||!phase||!x->registry)return PW_FOCUS_BAD_ID;
+    if(!x->poison&&check(c,x,now)){} /* poison is observable; never a success fence */
+    if(!x->poison&&now<=UINT64_MAX-LEASE)x->lease_deadline=now+LEASE;
+    *phase=(PwFocusPhase)x->phase;memset(out,0,sizeof(*out));
+    if(x->normal_result)*out=x->operations[x->normal_result-1].receipt;
+    return 0;
+}
+int pw_focus_ack(PwFocusCore *c,const PwFocusTicket *t,uint64_t now)
+{
+    PwFocusContext *x;PwFocusOperation *o=operation(c,t,&x);
+    if(!o||o->pending||o->receipt.repeat||x->normal_result!=t->operation+1)return PW_FOCUS_BAD_ID;
+    if(!x->poison&&check(c,x,now)){} /* factual result still consumable after failure */
+    o->used=0;x->normal_result=0;advance(x);drop(c,x);return 0;
+}
+int pw_focus_quiesce(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch,uint64_t now)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);if(check(c,x,now)||x->phase!=PW_FOCUS_ACTIVE)return PW_FOCUS_REFUSED;
+    x->phase=PW_FOCUS_DRAINING;timer_off(c,x);advance(x);return 0;
+}
+int pw_focus_settle(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch,uint64_t now)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);if(check(c,x,now)||x->phase!=PW_FOCUS_RELEASE_READY||x->outstanding||x->normal_result||x->timer)return PW_FOCUS_REFUSED;
+    for(unsigned i=0;i<PW_FOCUS_KEYS;i++)if(x->held[i])return PW_FOCUS_REFUSED;
+    x->phase=PW_FOCUS_SETTLED;return 0;
+}
+int pw_focus_close(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);
+    if(!x||x->phase!=PW_FOCUS_SETTLED||x->refs!=1||!x->registry)return PW_FOCUS_REFUSED;
+    x->phase=PW_FOCUS_CLOSED;x->registry=0;drop(c,x);return 0;
+}
+int pw_focus_timer(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch,unsigned attach,const PwFocusTicket *parent,uint64_t now)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);if(!x||attach>1)return PW_FOCUS_BAD_ID;
+    if(!attach){timer_off(c,x);return 0;}
+    if(check(c,x,now)||x->phase!=PW_FOCUS_ACTIVE||x->timer)return PW_FOCUS_REFUSED;
+    PwFocusContext *owner;PwFocusOperation *o=operation(c,parent,&owner);
+    if(!o||owner!=x||!o->receipt.down||o->receipt.repeat||o->receipt.key>=PW_FOCUS_KEYS)return PW_FOCUS_BAD_ID;
+    x->timer=1;x->timer_key=o->receipt.key;x->timer_parent=o->receipt.ticket.seq;x->refs++;return 0;
+}
+int pw_focus_abandon(PwFocusCore *c,uint32_t n,uint64_t cookie,uint64_t epoch,unsigned reason)
+{
+    PwFocusContext *x=find(c,n,cookie,epoch);if(!x||!x->registry)return PW_FOCUS_BAD_ID;
+    poison(c,x,reason);x->registry=0;
+    if(x->normal_result){x->operations[x->normal_result-1].used=0;x->normal_result=0;drop(c,x);}
+    drop(c,x);return 0;
+}
+int pw_focus_watchdog(PwFocusCore *c,uint32_t n,uint64_t now)
+{
+    if(!c||!c->initialized||n>=PW_FOCUS_CONTEXTS)return PW_FOCUS_REFUSED;
+    PwFocusContext *x=&c->contexts[n];
+    if(!x->registry)return 0;
+    if(x->poison||!permit_ok(c,x,now))return pw_focus_abandon(c,n,x->cookie,x->epoch,6);
+    x->last_clock=now;return 0;
+}
+int pw_focus_invariants(const PwFocusCore *c)
+{
+    if(!c||!c->initialized)return 0;
+    for(unsigned n=0;n<PW_FOCUS_CONTEXTS;n++){
+        const PwFocusContext *x=&c->contexts[n];unsigned used=0,pending=0,normal=0;
+        for(unsigned i=0;i<PW_FOCUS_OPS;i++)if(x->operations[i].used){used++;pending+=x->operations[i].pending;
+            if(!x->operations[i].receipt.repeat)normal++;
+        }
+        if(x->refs!=x->registry+x->timer+used||x->outstanding!=pending||normal>1)return 0;
+        if(x->refs&&(!x->process||!x->desktop||!x->window))return 0;
+        if(!x->refs&&(x->process||x->desktop||x->window))return 0;
+        if(x->normal_result){unsigned i=x->normal_result-1;if(i>=PW_FOCUS_OPS||!x->operations[i].used||x->operations[i].pending||x->operations[i].receipt.repeat)return 0;}
+        if(x->timer&&(x->phase!=PW_FOCUS_ACTIVE||x->poison||!x->timer_parent||!x->timer_key))return 0;
+        if(x->phase==PW_FOCUS_SETTLED||x->phase==PW_FOCUS_CLOSED){if(used||x->timer||x->poison)return 0;for(unsigned i=0;i<PW_FOCUS_KEYS;i++)if(x->held[i])return 0;}
+        if(x->phase==PW_FOCUS_RELEASE_READY&&(used||x->timer||x->poison))return 0;
+    }
+    return 1;
+}
+static unsigned eligible(const PwFocusSources *s,unsigned key)
+{unsigned down=0;for(unsigned n=0;n<PW_FOCUS_SOURCES;n++)down|=s->connected[n]&&s->physical[n][key]&&!s->blocked[n][key];return down;}
+void pw_focus_sources_block(PwFocusSources *s)
+{if(s)for(unsigned n=0;n<PW_FOCUS_SOURCES;n++)for(unsigned k=0;k<PW_FOCUS_KEYS;k++)s->blocked[n][k]=s->physical[n][k];}
+int pw_focus_sources_attach(PwFocusSources *s,unsigned n,uint64_t generation)
+{
+    if(!s||n>=PW_FOCUS_SOURCES||!generation||s->connected[n]||generation<=s->generation[n])return -1;
+    s->generation[n]=generation;s->connected[n]=1;
+    for(unsigned k=0;k<PW_FOCUS_KEYS;k++)if(s->physical[n][k])s->blocked[n][k]=1;
+    return 0;
+}
+int pw_focus_sources_observe(PwFocusSources *s,unsigned n,uint64_t generation,unsigned key,unsigned down,unsigned *merged)
+{
+    if(!s||!merged||n>=PW_FOCUS_SOURCES||!s->connected[n]||generation!=s->generation[n]||!key||key>=PW_FOCUS_KEYS||down>1)return -1;
+    unsigned before=eligible(s,key);s->physical[n][key]=(unsigned char)down;
+    if(!down)s->blocked[n][key]=0;
+    *merged=eligible(s,key);return before!=*merged;
+}
+int pw_focus_sources_disconnect(PwFocusSources *s,unsigned n,uint64_t generation)
+{if(!s||n>=PW_FOCUS_SOURCES||!s->connected[n]||generation!=s->generation[n])return -1;s->connected[n]=0;for(unsigned k=0;k<PW_FOCUS_KEYS;k++)if(s->physical[n][k])s->blocked[n][k]=1;return 0;}
diff --git a/server/pw_focus_core.h b/server/pw_focus_core.h
new file mode 100644
index 0000000..22141f1
--- /dev/null
+++ b/server/pw_focus_core.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Isolated server-core prototype. No native routing, protocol registration or
+ * target enablement. Caller MUST serialize every call in Wine's server domain. */
+#ifndef PW_FOCUS_CORE_H
+#define PW_FOCUS_CORE_H
+#include <stddef.h>
+#include <stdint.h>
+#define PW_FOCUS_CONTEXTS 17u
+#define PW_FOCUS_OPS 64u
+#define PW_FOCUS_KEYS 259u
+#define PW_FOCUS_SOURCES 8u
+
+typedef enum { PW_FOCUS_ROOT=1, PW_FOCUS_CHILD=2 } PwFocusDomain;
+typedef struct {
+    uint64_t session, generation;
+    uint32_t native_pid, wine_pid, domain;
+} PwFocusIdentity;
+typedef struct {
+    PwFocusIdentity identity;
+    uint64_t epoch, expires;
+    void *process;
+    unsigned joined, frame_ready;
+} PwFocusPermit;
+/* Populated by the server adapter from current->process, not request bytes. */
+typedef struct {
+    void *process;
+    uint64_t fixture_generation;
+    uint32_t native_pid, wine_pid, fixture_joined;
+} PwFocusServerFacts;
+typedef struct {
+    void *context;
+    /* Return a trusted native permit for the ACTUAL process, never echo request. */
+    int (*permit)(void *, void *process, PwFocusPermit *);
+    void *(*pin)(void *, void *object);
+    void (*unpin)(void *, void *object);
+    int (*window_live)(void *, void *process, void *desktop, void *window,
+                       uint64_t handle, uint64_t user_generation);
+} PwFocusCallbacks;
+typedef enum { PW_FOCUS_EMPTY, PW_FOCUS_ACTIVE, PW_FOCUS_DRAINING,
+    PW_FOCUS_RELEASE_READY, PW_FOCUS_RELEASING, PW_FOCUS_SETTLED,
+    PW_FOCUS_POISONED, PW_FOCUS_CLOSED } PwFocusPhase;
+typedef enum { PW_FOCUS_CLEAN=1, PW_FOCUS_SUPPRESSED=2,
+    PW_FOCUS_APPLIED_EXCEPTION=3, PW_FOCUS_FAILED=4, PW_FOCUS_MOTION_NO_CHANGE=5 } PwFocusOutcome;
+typedef enum { PW_FOCUS_OK=0, PW_FOCUS_REFUSED=-1, PW_FOCUS_BUSY=-2,
+    PW_FOCUS_BAD_ID=-3, PW_FOCUS_LIMIT=-4 } PwFocusResult;
+typedef struct {
+    uint64_t cookie, epoch, seq;
+    uint32_t slot, operation;
+} PwFocusTicket;
+typedef struct {
+    PwFocusTicket ticket;
+    uint64_t client_seq, desktop_serial, parent_seq;
+    uint32_t key, down, repeat, outcome, hook_error;
+} PwFocusReceipt;
+typedef struct {
+    PwFocusReceipt receipt;
+    unsigned used, pending;
+} PwFocusOperation;
+typedef struct {
+    PwFocusIdentity identity;
+    uint64_t epoch, cookie, handle, user_generation, last_client_seq, issued;
+    uint64_t last_clock, lease_deadline, timer_parent;
+    uint32_t timer_key;
+    void *process, *desktop, *window;
+    PwFocusOperation operations[PW_FOCUS_OPS];
+    unsigned char held[PW_FOCUS_KEYS];
+    uint32_t refs, outstanding, phase, poison, registry, timer, normal_result;
