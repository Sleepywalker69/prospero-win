+#ifdef PW_FOCUS_SERVER_ADAPTER
+/* Experimental server-private adapter; all callers execute in the serialized
+ * Wine server domain. No request handler or native input route registers it. */
+PwFocusCore pw_focus_server_core;
+/* Single-transfer ownership, separate from the core pending/result lifecycle. */
+static PwFocusTicket focus_submissions[PW_FOCUS_CONTEXTS][PW_FOCUS_OPS];
+
+static uint64_t focus_now(void)
+{
+    return monotonic_time / 10000;
+}
+
+static PwFocusContext *focus_context(const PwFocusTicket *ticket)
+{
+    PwFocusCore *core = &pw_focus_server_core;
+    PwFocusContext *context;
+    if (!core->initialized || !ticket || ticket->slot >= PW_FOCUS_CONTEXTS) return NULL;
+    context = &core->contexts[ticket->slot];
+    if (!ticket->cookie || context->cookie != ticket->cookie || context->epoch != ticket->epoch) return NULL;
+    return context;
+}
+
+static PwFocusOperation *focus_operation(const PwFocusTicket *ticket)
+{
+    PwFocusContext *context = focus_context(ticket);
+    PwFocusOperation *op;
+    if (!context || ticket->operation >= PW_FOCUS_OPS) return NULL;
+    op = &context->operations[ticket->operation];
+    if (!op->used || !op->pending || op->receipt.ticket.seq != ticket->seq) return NULL;
+    return op;
+}
+
+static int focus_claim(const PwFocusTicket *ticket, struct pw_focus_tag *tag)
+{
+    PwFocusTicket *owned;
+    if (!focus_operation(ticket)) return 0;
+    owned = &focus_submissions[ticket->slot][ticket->operation];
+    if (owned->cookie) return 0;
+    *owned = *ticket;
+    *tag = (struct pw_focus_tag){*ticket, 1, 0};
+    return 1;
+}
+
+static int focus_timer_matches(struct desktop *desktop, const PwFocusTicket *ticket)
+{
+    struct pw_focus_timer_tag *tag = &desktop->key_repeat.focus;
+    return tag->active && tag->slot == ticket->slot && tag->cookie == ticket->cookie && tag->epoch == ticket->epoch;
+}
+
+static void stop_key_repeat(struct desktop *desktop);
+
+static void focus_sync_timer(struct desktop *desktop)
+{
+    struct pw_focus_timer_tag *tag = &desktop->key_repeat.focus;
+    PwFocusTicket ticket = {tag->cookie, tag->epoch, 0, tag->slot, 0};
+    PwFocusContext *context;
+    if (!tag->active) return;
+    context = focus_context(&ticket);
+    if (!context || !context->timer || context->desktop != desktop || context->phase != PW_FOCUS_ACTIVE)
+        stop_key_repeat(desktop);
+}
+
+static void focus_complete_tag(struct pw_focus_tag *tag, PwFocusOutcome outcome,
+                               unsigned int error, uint64_t serial)
+{
+    PwFocusContext *context;
+    struct desktop *desktop;
+    PwFocusTicket ticket;
+    if (!tag->active) return;
+    ticket = tag->ticket;
+    assert(focus_submissions[ticket.slot][ticket.operation].cookie == ticket.cookie &&
+           focus_submissions[ticket.slot][ticket.operation].seq == ticket.seq);
+    memset(&focus_submissions[ticket.slot][ticket.operation], 0, sizeof(PwFocusTicket));
+    tag->active = 0; /* clear before any completion can release object pins */
+    context = focus_context(&ticket);
+    assert(context && focus_operation(&ticket));
+    desktop = (struct desktop *)grab_object(context->desktop);
+    {
+        int result = pw_focus_complete(&pw_focus_server_core, &ticket, outcome, error, serial);
+        assert(!result);
+        (void)result;
+    }
+    focus_sync_timer(desktop);
+    release_object(desktop);
