+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_FOCUS_ADAPTER_H
+#define PW_FOCUS_ADAPTER_H
+#include "pw_focus_core.h"
+struct pw_focus_tag { PwFocusTicket ticket; unsigned int active, hook_error; };
+struct pw_focus_timer_tag { uint64_t cookie, epoch; uint32_t slot, active; };
+extern PwFocusCore pw_focus_server_core;
+extern struct window *pw_focus_pin_window(struct process *, struct desktop *, user_handle_t, uint64_t *);
+extern int pw_focus_window_live(void *, void *, void *, void *, uint64_t, uint64_t);
+extern void pw_focus_window_detached(struct window *);
+extern int pw_focus_queue_quiesce(uint32_t, uint64_t, uint64_t);
+extern void pw_focus_queue_abandon(uint32_t, uint64_t, uint64_t);
+extern int pw_focus_queue_keyboard(const PwFocusTicket *, struct desktop *, user_handle_t, const union hw_input *);
+extern void pw_focus_stop_key_repeat(struct desktop *);
+extern int pw_focus_queue_begin(uint32_t, uint64_t, uint64_t, uint64_t, uint32_t, unsigned int, PwFocusTicket *);
+extern int pw_focus_queue_poll(uint32_t, uint64_t, uint64_t, PwFocusReceipt *, PwFocusPhase *);
+extern int pw_focus_queue_ack(const PwFocusTicket *);
+extern int pw_focus_queue_settle(uint32_t, uint64_t, uint64_t);
+extern void pw_focus_queue_watchdog(void);
