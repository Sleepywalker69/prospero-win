+/* A switcher snapshot contains only process-local, live registry identities.
+ * It intentionally does not enumerate Wine child-process transport surfaces. */
+struct ps5_window_choice
+{
+    HWND hwnd, root;
+    UINT64 generation;
+};
+
+static BOOL window_choice_live( const struct ps5_window_choice *choice )
+{
+    struct ps5_window *window;
+    BOOL live;
+
+    pthread_mutex_lock( &screen_lock );
+    window = find_window( choice->hwnd );
+    live = window && window->shown && window->generation == choice->generation &&
+           !bridge_service_window( choice->hwnd );
+    pthread_mutex_unlock( &screen_lock );
+    return live && is_window( choice->hwnd );
+}
+
+/* Do not bypass a disabled modal owner. Owned dialogs remain in their owner's
+ * slot, and the topmost enabled dialog wins within that family. Popups marked
+ * NOACTIVATE, tool windows and minimized windows never become cycle targets. */
+static HWND cycle_window( HWND current, INT direction )
+{
+    struct ps5_window_choice choices[PS5_MAX_WINDOWS], target;
+    HWND roots[PS5_MAX_WINDOWS], current_root, hwnd, root;
+    UINT count = 0, roots_count = 0, i, j, step;
+    INT current_index = -1, index;
+    DWORD style, exstyle, process;
+
+    pthread_mutex_lock( &screen_lock );
+    for (i = 0; i < window_count; i++)
+        if (windows[i].shown && !bridge_service_window( windows[i].hwnd ))
+            choices[count++] = (struct ps5_window_choice){windows[i].hwnd, 0, windows[i].generation};
+    pthread_mutex_unlock( &screen_lock );
+    current_root = current ? NtUserGetAncestor( current, GA_ROOTOWNER ) : 0;
+    for (i = 0; i < count; i++)
+    {
+        hwnd = choices[i].hwnd;
+        process = 0;
+        if (!window_choice_live( &choices[i] ) || !NtUserGetWindowThread( hwnd, &process ) ||
+            process != GetCurrentProcessId()) continue;
+        style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+        exstyle = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
+        if (!(style & WS_VISIBLE) || (style & (WS_DISABLED | WS_MINIMIZE | WS_CHILD)) ||
+            (exstyle & (WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW))) continue;
+        root = NtUserGetAncestor( hwnd, GA_ROOTOWNER );
+        if (!root) continue;
+        choices[i].root = root;
+        for (j = 0; j < roots_count && roots[j] != root; j++) {}
+        if (j == roots_count) roots[roots_count++] = root;
+        if (root == current_root) current_index = j;
+    }
+    if (!roots_count) return current;
+    for (step = 1; step <= roots_count; step++)
+    {
+        index = current_index < 0 ? (direction > 0 ? (INT)step - 1 : (INT)roots_count - (INT)step) :
+                (current_index + direction * (INT)step + (INT)roots_count) % (INT)roots_count;
+        root = roots[index];
+        /* USER's z-order also maintains owned popup ordering. Find the first
+         * eligible member there instead of selecting a disabled owner. */
+        target = (struct ps5_window_choice){0};
+        for (hwnd = NtUserGetWindowRelative( get_desktop_window(), GW_CHILD ); hwnd;
+             hwnd = NtUserGetWindowRelative( hwnd, GW_HWNDNEXT ))
+        {
+            for (i = 0; i < count; i++)
+                if (choices[i].hwnd == hwnd && choices[i].root == root && window_choice_live( &choices[i] ))
+                { target = choices[i]; break; }
+            if (target.hwnd) break;
+        }
+        if (!target.hwnd || !window_choice_live( &target )) continue;
+        if (NtUserGetWindowLongW( target.hwnd, GWL_STYLE ) & (WS_DISABLED | WS_MINIMIZE)) continue;
+        /* USER owns activation/focus notifications and owner z-order. Never
+         * synthesize WM_SETFOCUS or directly mutate its foreground handle. */
+        if (!NtUserSetForegroundWindow( target.hwnd )) return current;
+        if (!window_choice_live( &target )) return NtUserGetForegroundWindow();
+        NtUserSetWindowPos( target.hwnd, HWND_TOP, 0, 0, 0, 0,
+                            SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE );
+        NtUserRedrawWindow( get_desktop_window(), NULL, 0,
+                            RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+        return NtUserGetForegroundWindow();
+    }
+    return current;
+}
+
+static UINT64 window_input_generation( HWND hwnd )
+{
+    struct ps5_window *window;
+    UINT64 generation;
+
+    pthread_mutex_lock( &screen_lock );
+    window = find_window( hwnd );
+    generation = window ? window->generation : 0;
+    pthread_mutex_unlock( &screen_lock );
+    return generation;
+}
+
+/* input_lock held; release against the old HWND before USER changes focus.
+ * A destroyed HWND must never be replaced with NULL (which redirects to the
+ * new foreground window). Destruction already discards its input queue. */
+static void release_window_input(void)
+{
+    static const DWORD button_up[] = {MOUSEEVENTF_LEFTUP, MOUSEEVENTF_RIGHTUP, MOUSEEVENTF_MIDDLEUP};
+    INPUT input = {.type = INPUT_KEYBOARD};
+    UINT i;
+    BOOL live = input_owner && is_window( input_owner ) &&
+                window_input_generation( input_owner ) == input_generation;
+
+    for (i = 1; i < 256; i++)
+    {
+        if (held_keys[i] && live)
+        {
+            input.ki.wVk = i;
+            input.ki.wScan = NtUserMapVirtualKeyEx( i, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
+            input.ki.dwFlags = KEYEVENTF_KEYUP | (is_extended_key( i ) ? KEYEVENTF_EXTENDEDKEY : 0);
+            NtUserSendHardwareInput( input_owner, 0, &input, 0 );
+        }
+        held_keys[i] = 0;
+    }
+    for (i = 0; i < 3; i++)
+    {
+        if (held_buttons[i] && live) send_mouse( input_owner, button_up[i], 0, 0 );
+        held_buttons[i] = 0;
+    }
+    input_owner = 0;
+    input_generation = 0;
+}
