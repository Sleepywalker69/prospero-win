+/* Wine supplies surface-local visible regions after z-order changes. Ignoring
+ * these lets a background repaint cover the active dialog or selected app. */
 static void ps5_surface_set_clip( struct window_surface *surface, const RECT *rects, UINT count )
 {
+    struct ps5_surface *ps5 = (struct ps5_surface *)surface;
+    RECT *copy = NULL;
+
+    if (count && (copy = malloc( (size_t)count * sizeof(*copy) )))
+        memcpy( copy, rects, (size_t)count * sizeof(*copy) );
+    free( ps5->clip );
+    ps5->clip = copy;
+    ps5->clip_count = copy ? count : 0;
+    /* Allocation failure fails closed, never paints over another window. */
+    ps5->clipped = surface->clip_region != 0 || (count && !copy);
+    /* dce.c keeps bounds/dirty bitmap-local even for an offset surface. */
+    SetRect( &surface->bounds, 0, 0, surface->rect.right - surface->rect.left,
+             surface->rect.bottom - surface->rect.top );
 }
 
