From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Sun, 11 Oct 2026 15:00:00 +0000
Subject: [PATCH] server: report in-process fatal startup errors through the title sink

Forward fatal diagnostics before exit without depending on fd 2. Keep logical
errors distinct from valid syscall errno, preserve errno across formatting and
callbacks, and retain the original stderr path when no sink is installed.
The bounded message includes the failed operation and path. No startup,
readiness, privilege, ownership, exit status or child policy is changed.
---
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1916,8 +1916,30 @@
  *
  * Load the server module beside ntdll (server/ in a build tree), start it
  * on first use and get a new client connection from it.
  */
+/* PW_SERVER_FATAL_BRIDGE_BEGIN */
+static void forward_server_fatal( const char *message, size_t length )
+{
+    int saved_errno = errno;
+    wine_write_stderr( message, length );
+    errno = saved_errno;
+}
+
+static void install_server_fatal_sink( void *module )
+{
+    int saved_errno = errno;
+    int (*install)( void (*)( const char *, size_t ) ) =
+        dlsym( module, "pw_wineserver_set_fatal_sink" );
+    const char *message = install && !install( forward_server_fatal ) ?
+        "wine startup: server fatal sink installed\n" :
+        "wine startup: server fatal sink unavailable\n";
+    /* Diagnostics do not turn an older server into a new startup failure. */
+    wine_write_stderr( message, strlen( message ) );
+    errno = saved_errno;
+}
+/* PW_SERVER_FATAL_BRIDGE_END */
+
 static int connect_inprocess_server(void)
 {
     Dl_info info;
     char *dir = NULL, *module_path, *nls_dir, *p;
@@ -1947,8 +1969,9 @@
     if (!module_path || !nls_dir) fatal_error( "out of memory\n" );
 
     if (!(module = dlopen( module_path, RTLD_NOW )))
         fatal_error( "cannot load the in-process server %s: %s\n", module_path, dlerror() );
+    install_server_fatal_sink( module );
 #ifdef __PROSPERO__
     share_name_changes( module );  /* before the server starts creating files */
 #endif
     if (!(connect_server = dlsym( module, "pw_wineserver_connect" )))
