+/* PW_SERVER_FATAL_DIAGNOSTIC_BEGIN
+ * The in-process server can fail before fd 2 works. Install its local sink
+ * before startup, without requiring a file descriptor or a server request. */
+#ifdef WINE_INPROCESS_SERVER
+static void (*server_fatal_sink)( const char *, size_t );
+
+DECLSPEC_EXPORT int pw_wineserver_set_fatal_sink( void (*sink)( const char *, size_t ) )
+{
+    void (*expected)( const char *, size_t ) = NULL;
+    if (!sink) return -1;
+    if (__atomic_compare_exchange_n( &server_fatal_sink, &expected, sink, 0,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE )) return 0;
+    return expected == sink ? 0 : -1;
+}
+#endif
+
+static void server_fatal_report( int errno_valid, int saved_errno,
+                                 const char *err, va_list args )
+{
+#ifdef WINE_INPROCESS_SERVER
+    void (*sink)( const char *, size_t ) =
+        __atomic_load_n( &server_fatal_sink, __ATOMIC_ACQUIRE );
+    if (sink)
+    {
+        char message[768], line[1024];
+        int formatted, length, truncated;
+        size_t i;
+
+        formatted = vsnprintf( message, sizeof(message), err, args );
+        truncated = formatted < 0 || (size_t)formatted >= sizeof(message);
+        if (formatted < 0) strcpy( message, "<format-error>" );
+        /* One bounded record, including paths containing newlines or '%'. */
+        for (i = 0; message[i]; ++i)
+            if (message[i] == '\n' || message[i] == '\r') message[i] = ' ';
+        length = snprintf( line, sizeof(line),
+                           "wineserver: fatal errno_valid=%d errno=%d truncated=%d message=%s\n",
+                           errno_valid, errno_valid ? saved_errno : 0, truncated, message );
+        if (length > 0)
+            sink( line, (size_t)length < sizeof(line) ? (size_t)length : sizeof(line) - 1 );
+        errno = saved_errno;
+        return;
+    }
+#endif
+    /* Keep ordinary/older-host stderr behavior when no local sink exists. */
     fprintf( stderr, "wineserver: " );
     vfprintf( stderr, err, args );
+    if (errno_valid) fprintf( stderr, ": %s\n", strerror( saved_errno ) );
+    errno = saved_errno;
+}
+
+/* die on a fatal error; a logical failure does not validate stale errno */
+void fatal_error( const char *err, ... )
+{
+    va_list args;
+    int saved_errno = errno;
+
+    va_start( args, err );
+    server_fatal_report( 0, saved_errno, err, args );
     va_end( args );
+    errno = saved_errno;
     exit(1);
 }
+
+static void fatal_perror( const char *err, ... )
+    __attribute__((noreturn, format(printf,1,2)));
+
+/* Only call immediately after a failed errno-bearing operation. In
+ * particular, do not evaluate strerror(errno) before saving that errno. */
+static void fatal_perror( const char *err, ... )
+{
+    va_list args;
+    int saved_errno = errno;
+
+    va_start( args, err );
+    server_fatal_report( 1, saved_errno, err, args );
+    va_end( args );
+    errno = saved_errno;
+    exit(1);
+}
+/* PW_SERVER_FATAL_DIAGNOSTIC_END */
 
 /* allocate the reply data */
 void *set_reply_data_size( data_size_t size )
 {
