--- /dev/null
+++ b/include/wine/pw_private_dispatch_i386.h
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef __WINE_PW_PRIVATE_DISPATCH_I386_H
+#define __WINE_PW_PRIVATE_DISPATCH_I386_H
+
+#include "wine/pw_private_dispatch.h"
+
+/* Additional contract for translated I386 guests. The AMD64 private slot,
+ * mapping and ABI1 remain unchanged. This helper reads only bounded image
+ * bytes; it never invokes a thunk, dereferences an encoded VA or maps memory. */
+#define PW_PRIVATE_DISPATCH_WOW64_ABI 1
+
+static inline int pw_pd_i386_section(const struct pw_pd_image *image,
+                                    unsigned int rva, unsigned int length,
+                                    unsigned int required, unsigned int forbidden)
+{
+    unsigned int i;
+    if (!pw_pd_readable(image, rva, length)) return 0;
+    for (i = 0; i < image->section_count; i++)
+    {
+        const unsigned char *section = image->bytes + image->sections + 40 * i;
+        unsigned int start = pw_pd_u32(section + 12), span = pw_pd_u32(section + 8);
+        unsigned int flags = pw_pd_u32(section + 36);
+        if (start <= rva && rva - start < span && length <= span - (rva - start))
+            return (flags & required) == required && !(flags & forbidden);
+    }
+    return 0;
+}
+
+static inline int pw_pd_i386_name(const struct pw_pd_image *image, unsigned int rva,
+                                 const char *expected)
+{
+    unsigned int i, equal = 1;
+    for (i = 0; i < 512; i++)
+    {
+        unsigned char value;
+        if (rva > 0xffffffffu - i || !pw_pd_readable(image, rva + i, 1)) return -1;
+        value = image->bytes[rva + i];
+        if (equal && value != (unsigned char)expected[i]) equal = 0;
+        if (!value) return (int)equal;
+    }
+    return -1;
+}
+
+/* PE32 operands may still describe OptionalHeader.ImageBase when this runs:
+ * Wine can perform the final relocation after the mapping-time check.
+ * Require an exact HIGHLOW relocation for each absolute operand. Any other
+ * relocation touching either instruction sequence is refused. */
+static inline int pw_pd_i386_relocations(const struct pw_pd_image *image,
+                                        unsigned int directory, unsigned int size,
+                                        unsigned int thunk, unsigned int helper, unsigned int slot)
+{
+    unsigned int offset = 0, found_thunk = 0, found_helper = 0;
+    if (!directory || size < 8 || !pw_pd_readable(image, directory, size)) return 0;
+    while (offset < size)
+    {
+        unsigned int page, block, i;
+        if (size - offset < 8) return 0;
+        page = pw_pd_u32(image->bytes + directory + offset);
+        block = pw_pd_u32(image->bytes + directory + offset + 4);
+        if (block < 8 || block > size - offset || block % 2 || page % 0x1000) return 0;
+        for (i = 8; i < block; i += 2)
+        {
+            unsigned int entry = pw_pd_u16(image->bytes + directory + offset + i);
+            unsigned int type = entry >> 12, rva;
+            if (!type) continue; /* IMAGE_REL_BASED_ABSOLUTE padding */
+            if (type != 3 || page > 0xffffffffu - (entry & 0xfff)) return 0;
+            rva = page + (entry & 0xfff);
+            if (!pw_pd_readable(image, rva, 4) || (rva < slot + 4 && slot < rva + 4)) return 0;
+            if (rva < thunk + 15 && thunk < rva + 4)
+            {
+                if (rva != thunk + 6 || found_thunk++) return 0;
+            }
+            if (rva < helper + 6 && helper < rva + 4)
+            {
+                if (rva != helper + 2 || found_helper++) return 0;
+            }
+        }
+        offset += block;
+    }
+    return found_thunk == 1 && found_helper == 1;
+}
+
+/* Match the actual non-PIC __ASM_SYSCALL_FUNC/DEFINE_SYSCALL_HELPER32 output.
+ * The selected anchors both pop one 32-bit argument. ntdll exports its private
+ * pointer by name; win32u exposes the same private variable as Wow64Transition.
+ * Neither encoded address may refer to the shared user-data page. */
+static inline int pw_private_dispatch_i386_image_valid(const unsigned char *bytes,
+        unsigned long size, const char *anchor, const char *dispatcher)
+{
+    struct pw_pd_image image;
+    unsigned int pe, optional, optional_size, directory, directory_size, base;
+    unsigned int functions, names, function_table, name_table, ordinal_table, i;
+    unsigned int thunk = 0, slot = 0, helper, found_thunk = 0, found_slot = 0;
+    unsigned long limit;
+    const unsigned char *code;
+    if (!bytes || !anchor || !dispatcher || size < 64 || bytes[0] != 'M' || bytes[1] != 'Z') return 0;
+    limit = size < 0x1000 ? size : 0x1000;
+    pe = pw_pd_u32(bytes + 60);
+    if (pe > limit || limit - pe < 24 || pw_pd_u32(bytes + pe) != 0x00004550 ||
+        pw_pd_u16(bytes + pe + 4) != 0x014c) return 0;
+    image.section_count = pw_pd_u16(bytes + pe + 6);
+    optional_size = pw_pd_u16(bytes + pe + 20);
+    optional = pe + 24;
+    if (!image.section_count || image.section_count > 96 || optional_size < 144 ||
+        optional_size > limit - optional || pw_pd_u16(bytes + optional) != 0x10b) return 0;
+    image.bytes = bytes;
+    image.size = pw_pd_u32(bytes + optional + 56);
+    image.headers = pw_pd_u32(bytes + optional + 60);
+    image.sections = optional + optional_size;
+    base = pw_pd_u32(bytes + optional + 28);
+    if (!base || !image.size || image.size > size || image.size > 0xffffffffu - base ||
+        image.headers > limit || image.headers > image.size || image.sections > image.headers ||
+        image.section_count * 40 > image.headers - image.sections ||
+        pw_pd_u32(bytes + optional + 92) < 6) return 0;
+    for (i = 0; i < image.section_count; i++)
+    {
+        const unsigned char *section = bytes + image.sections + 40 * i;
+        unsigned int start = pw_pd_u32(section + 12), span = pw_pd_u32(section + 8), j;
+        if (start > image.size || span > image.size - start || (span && start < image.headers)) return 0;
+        for (j = 0; span && j < i; j++)
+        {
+            const unsigned char *prior = bytes + image.sections + 40 * j;
+            unsigned int old_start = pw_pd_u32(prior + 12), old_span = pw_pd_u32(prior + 8);
+            if (old_span && start < old_start + old_span && old_start < start + span) return 0;
+        }
+    }
+    directory = pw_pd_u32(bytes + optional + 96);
+    directory_size = pw_pd_u32(bytes + optional + 100);
+    if (!directory || directory_size < 40 || !pw_pd_readable(&image, directory, directory_size)) return 0;
+    functions = pw_pd_u32(bytes + directory + 20);
+    names = pw_pd_u32(bytes + directory + 24);
+    function_table = pw_pd_u32(bytes + directory + 28);
+    name_table = pw_pd_u32(bytes + directory + 32);
+    ordinal_table = pw_pd_u32(bytes + directory + 36);
+    if (!functions || functions > 65536 || !names || names > 65536 ||
+        !function_table || !name_table || !ordinal_table ||
+        !pw_pd_readable(&image, function_table, functions * 4) ||
+        !pw_pd_readable(&image, name_table, names * 4) ||
+        !pw_pd_readable(&image, ordinal_table, names * 2)) return 0;
+    for (i = 0; i < names; i++)
+    {
+        unsigned int name = pw_pd_u32(bytes + name_table + i * 4);
+        unsigned int ordinal = pw_pd_u16(bytes + ordinal_table + i * 2), function;
+        int is_anchor = pw_pd_i386_name(&image, name, anchor);
+        int is_slot = pw_pd_i386_name(&image, name, dispatcher);
+        if (is_anchor < 0 || is_slot < 0 || ordinal >= functions) return 0;
+        function = pw_pd_u32(bytes + function_table + ordinal * 4);
+        if (function && !pw_pd_readable(&image, function, 1)) return 0;
+        if (!is_anchor && !is_slot) continue;
+        if (!function || (function >= directory && function - directory < directory_size)) return 0;
+        if (is_anchor) { if (found_thunk++) return 0; thunk = function; }
+        if (is_slot) { if (found_slot++) return 0; slot = function; }
+    }
+    if (found_thunk != 1 || found_slot != 1 ||
+        !pw_pd_i386_section(&image, thunk, 15, 0x60000000, 0x90000000) ||
+        !pw_pd_i386_section(&image, slot, 4, 0xc0000000, 0x30000000) ||
+        pw_pd_u32(bytes + slot)) return 0;
+    code = bytes + thunk;
+    if (code[0] != 0xb8 || code[5] != 0xba || code[10] != 0xff || code[11] != 0xd2 ||
+        code[12] != 0xc2 || code[13] != 4 || code[14]) return 0;
+    helper = pw_pd_u32(code + 6);
+    if (helper < base) return 0;
+    helper -= base;
+    if (!pw_pd_i386_section(&image, helper, 6, 0x60000000, 0x90000000) ||
+        (helper < thunk + 15 && thunk < helper + 6) ||
+        bytes[helper] != 0xff || bytes[helper + 1] != 0x25 ||
+        pw_pd_u32(bytes + helper + 2) != base + slot) return 0;
+    return pw_pd_i386_relocations(&image, pw_pd_u32(bytes + optional + 136),
+                                  pw_pd_u32(bytes + optional + 140), thunk, helper, slot);
+}
+#endif
