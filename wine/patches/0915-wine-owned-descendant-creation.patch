@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "config.h"
+#include <stdint.h>
+#include <errno.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include "ntstatus.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "file.h"
+#include "process.h"
+#include "thread.h"
+#include "request.h"
+#include "creation.h"
+#ifdef PW_WINE_SERVICE_FIXTURE
+#include "wine/pw_wine_creation.h"
+#include "wine/pw_wine_fixture_socket.h"
+/* Only the serialized server touches these records. Bounded thread/process
+ * references and tombstones survive until native host exit; logical death
+ * cleans endpoints/revokes work independently of object destruction. */
+struct creation_record {
+    struct thread *caller;
+    struct thread *first;
+    struct process *child;
+    struct timeout_user *expiry;
+    uint64_t key, lease, generation, deadline, last_clock;
+    unsigned int terminal, bound, requested, submitted, received, tid;
+    int stream;
+};
+static struct creation_record creation_records[PW_WINE_CREATION_REQUESTS];
+static unsigned int creation_count;
+_Static_assert(SERVER_PROTOCOL_VERSION==PW_WINE_CREATION_PROTOCOL,"matched creation protocol");
+unsigned int DECLSPEC_EXPORT __wine_ps5_creation_protocol(void) { return SERVER_PROTOCOL_VERSION; }
+static uint32_t creation_now(uint64_t *out)
+{
+    struct timespec ts;
+    if(clock_gettime(CLOCK_MONOTONIC,&ts)||ts.tv_sec<0||ts.tv_nsec<0||ts.tv_nsec>=1000000000||
+       (uint64_t)ts.tv_sec>UINT64_MAX/1000)return STATUS_UNSUCCESSFUL;
+    uint64_t ms=(uint64_t)ts.tv_sec*1000,part=(uint64_t)ts.tv_nsec/1000000;
+    if(part>UINT64_MAX-ms)return STATUS_UNSUCCESSFUL;
+    *out=ms+part;return 0;
+}
+void pw_creation_transport_error(int raw,int error)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    if(p)p->transport_failure(p->context,0,0,raw,error);
+}
+void pw_creation_close_fd(int *slot)
+{
+    if(*slot<0)return;
+    int fd=*slot;*slot=-1;
+    int rc=close(fd),error=rc<0?errno:0;
+    if(rc)pw_creation_transport_error(rc,error);
+}
+static void creation_abort(struct creation_record *r)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    if(r->terminal)return;
+    r->terminal=1;
+    if(r->expiry){remove_timeout_user(r->expiry);r->expiry=NULL;}
+    pw_creation_close_fd(&r->stream);
+    if(r->generation&&p)p->abandon(p->context,r->generation,r->lease);
+}
+static void creation_expired(void *context);
+static int creation_arm_expiry(struct creation_record *r)
+{
+    uint64_t now;
+    if(creation_now(&now)||now<r->last_clock||now>=r->deadline){creation_abort(r);return 0;}
+    r->last_clock=now;
+    uint64_t left=r->deadline-now;
+    if(left>PW_WINE_CREATION_STARTUP_MS){creation_abort(r);return 0;}
+    r->expiry=add_timeout_user(-(timeout_t)left*10000,creation_expired,r);
+    if(!r->expiry){creation_abort(r);return 0;}
+    return 1;
+}
+static void creation_expired(void *context)
+{
+    struct creation_record *r=context;
+    /* The event loop removed the expired timer. A stale loop clock may fire
+     * early; resample against the original fixed endpoint, never renew it. */
+    r->expiry=NULL;
+    if(!r->terminal)creation_arm_expiry(r);
+}
+static struct creation_record *creation_find(uint64_t generation,uint64_t lease,uint64_t key)
+{
+    for(unsigned int i=0;i<creation_count;i++){
+        struct creation_record *r=&creation_records[i];
+        if(r->caller==current&&r->generation==generation&&r->lease==lease&&r->key==key)return r;
+    }
+    return NULL;
+}
+static uint32_t creation_check(struct creation_record *r,uint64_t *now)
+{
+    uint32_t status;
+    if(!r||r->terminal||r->caller->state==TERMINATED||r->caller->process->is_terminating)return STATUS_INVALID_PARAMETER;
+    if((status=creation_now(now))||*now<r->last_clock||*now>=r->deadline){
+        creation_abort(r);return status?status:STATUS_IO_TIMEOUT;
+    }
+    r->last_clock=*now;return 0;
+}
+static uint32_t creation_progress(struct creation_record *r,uint64_t now,PwWineCreationStatus *out)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    uint32_t status;
+    if(!p)return STATUS_NOT_SUPPORTED;
+    if(r->requested&&!r->submitted&&r->stream>=0){
+        status=p->submit(p->context,r->generation,r->lease,now,r->child->id,r->tid,&r->stream);
+        if(status){creation_abort(r);return status;}
+        if(r->stream!=-1){creation_abort(r);return STATUS_INTERNAL_ERROR;}
+        r->submitted=1;
+    }
+    status=p->query(p->context,r->generation,r->lease,now,out);
+    if(status)return status;
+    if(out->deadline!=r->deadline)return STATUS_INTERNAL_ERROR;
+    return 0;
+}
+void pw_creation_thread_dead(struct thread *thread)
+{
+    for(unsigned int i=0;i<creation_count;i++)
+        if(creation_records[i].caller==thread||
+           (creation_records[i].child==thread->process&&
+            thread->process->fixture_first==thread&&!thread->process->fixture_joined))
+            creation_abort(&creation_records[i]);
+}
+void pw_creation_process_dead(struct process *process)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    if(process->fixture_generation&&p)p->origin_dead(p->context,process->fixture_generation,process->id);
+}
+int pw_creation_receive_fd(struct thread *thread,int tag,int *owned)
+{
+    if(tag>=-1)return 0;
+    unsigned int index=(unsigned int)(-(int64_t)tag-2);
+    if(index<creation_count){
+        struct creation_record *r=&creation_records[index];
+        uint64_t now;
+        if(r->caller==thread&&r->caller->process==thread->process&&!r->terminal&&r->bound&&
+           !r->received&&!creation_now(&now)&&now>=r->last_clock&&now<r->deadline){
+            PwWineFixtureSocketResult checked;
+            if(!pw_wine_fixture_socket_prepare(*owned,PW_WF_SOCKET_CLOEXEC,&checked)){
+                r->stream=*owned;*owned=-1;r->received=1;r->last_clock=now;return 1;
+            }
+        }
+        if(r->caller==thread)creation_abort(r);
+    }
+    pw_creation_close_fd(owned);
+    return 1;
+}
+unsigned int pw_creation_bind(unsigned long long generation,struct process *child,
+                              unsigned int machine,const void *image,unsigned int bytes)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    if(!p)return STATUS_NOT_SUPPORTED;
+    for(unsigned int i=0;i<creation_count;i++){
+        struct creation_record *r=&creation_records[i];uint64_t now;uint32_t status;
+        if(r->caller!=current||r->generation!=generation)continue;
+        if(r->bound)return STATUS_INVALID_PARAMETER;
+        if((status=creation_check(r,&now)))return status;
+        status=p->bind(p->context,generation,r->lease,now,child->id,machine,image,bytes);
+        if(status)return status;
+        r->child=(struct process *)grab_object(child);r->bound=1;return 0;
+    }
+    return STATUS_INVALID_PARAMETER;
+}
+unsigned int pw_creation_join(unsigned long long generation,unsigned int pid,unsigned int tid,int native)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    if(!p||current->state==TERMINATED||current!=current->process->fixture_first||
+       current->process->fixture_joined||!generation||generation!=current->process->fixture_generation||
+       pid!=current->process->id||tid!=current->id||native<=0)return STATUS_INVALID_PARAMETER;
+    return p->join(p->context,generation,pid,tid,native);
+}
+DECL_HANDLER(creation_prepare)
+{
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    PwWineCreationRequest q={0};uint32_t status;unsigned int n=creation_count;
+    if(!p||!current->process->fixture_generation||!is_process_init_done(current->process)||
+       current->process->is_terminating||!req->key||n>=PW_WINE_CREATION_REQUESTS||
+       !req->image_bytes||req->image_bytes>sizeof(q.image)||(req->image_bytes&1)||
+       req->path_bytes<2||req->path_bytes>sizeof(q.path)||
+       get_req_data_size()!=req->image_bytes+req->path_bytes){set_error(STATUS_INVALID_PARAMETER);return;}
+    for(unsigned int i=0;i<n;i++)if(creation_records[i].caller==current&&
+       (!creation_records[i].terminal||creation_records[i].key>=req->key)){
+        set_error(STATUS_INVALID_PARAMETER);return;
+    }
+    if((status=creation_now(&q.now))){set_error(status);return;}
+    if(req->deadline<=q.now||req->deadline-q.now>PW_WINE_CREATION_STARTUP_MS){set_error(STATUS_IO_TIMEOUT);return;}
+    q.origin=current->process->fixture_generation;q.lease=n+1;q.key=req->key;q.deadline=req->deadline;
+    q.caller_pid=current->process->id;q.caller_tid=current->id;q.machine=req->machine;
+    q.image_bytes=req->image_bytes;q.path_bytes=req->path_bytes;
+    memcpy(q.image,get_req_data(),q.image_bytes);
+    memcpy(q.path,(const char *)get_req_data()+q.image_bytes,q.path_bytes);
+    if(q.path[q.path_bytes-1]||memchr(q.path,0,q.path_bytes-1)){set_error(STATUS_INVALID_PARAMETER);return;}
+    struct creation_record *r=&creation_records[creation_count++];
+    r->caller=(struct thread *)grab_object(current);r->lease=q.lease;r->key=q.key;
+    r->deadline=q.deadline;r->last_clock=q.now;r->stream=-1;
+    status=p->prepare(p->context,&q,&r->generation);
+    if(status||!r->generation){creation_abort(r);set_error(status?status:STATUS_INTERNAL_ERROR);return;}
+    PwWineCreationStatus observed;
+    status=p->query(p->context,r->generation,r->lease,q.now,&observed);
+    if(status||observed.deadline>r->deadline||observed.deadline<=q.now){
+        creation_abort(r);set_error(status?status:STATUS_INTERNAL_ERROR);return;
+    }
+    r->deadline=observed.deadline;
+    if(!creation_arm_expiry(r)){set_error(STATUS_IO_TIMEOUT);return;}
+    reply->generation=r->generation;reply->lease=r->lease;reply->deadline=r->deadline;
+    reply->tag=-(int)(n+2);
+}
+DECL_HANDLER(creation_query)
+{
+    struct creation_record *r=creation_find(req->generation,req->lease,req->key);
+    PwWineCreationStatus observed;uint64_t now;uint32_t status=creation_check(r,&now);
+    if(!status)status=creation_progress(r,now,&observed);
+    if(status){set_error(status);return;}
+    reply->deadline=observed.deadline;reply->phase=observed.phase;reply->status=observed.status;
+}
+DECL_HANDLER(creation_spawn)
+{
+    struct creation_record *r=creation_find(req->generation,req->lease,req->key);
+    struct process *process=NULL;struct thread *thread=NULL;uint64_t now;uint32_t status=creation_check(r,&now);
+    if(status){set_error(status);return;}
+    if(!r->bound||r->requested){set_error(STATUS_INVALID_PARAMETER);return;}
+    process=get_process_from_handle(req->process,0);
+    if(!process)return;
+    thread=get_thread_from_handle(req->thread,0);
+    if(!thread)goto done;
+    if(process!=r->child||thread->process!=process||thread!=process->fixture_first||
+       thread!=get_process_first_thread(process)||
+       process->fixture_generation!=r->generation||thread->state==TERMINATED){set_error(STATUS_INVALID_PARAMETER);goto done;}
+    r->first=(struct thread *)grab_object(thread);r->tid=thread->id;r->requested=1;
+    /* One receive at most; process_poll_event services any later message. */
+    if(r->stream<0)receive_fd(current->process);
+    if(!current)goto done;
+    PwWineCreationStatus observed;
+    if(!(status=creation_check(r,&now)))status=creation_progress(r,now,&observed);
+    if(status)set_error(status);
+ done:if(thread)release_object(thread);release_object(process);
+}
+DECL_HANDLER(creation_result)
+{
+    struct creation_record *r=creation_find(req->generation,req->lease,req->key);
+    const PwWineCreationProvider *p=pw_wine_creation_get();
+    if(!r||r->terminal||!p||req->success>1){set_error(STATUS_INVALID_PARAMETER);return;}
+    if(req->transfer_uncertain>1||req->transfer_error<0||
+       (!req->transfer_uncertain&&(req->transfer_raw||req->transfer_error))){set_error(STATUS_INVALID_PARAMETER);return;}
+    if(req->transfer_uncertain)p->transport_failure(p->context,r->generation,r->lease,req->transfer_raw,req->transfer_error);
+    uint32_t status=p->result(p->context,r->generation,r->lease,req->success,req->status);
+    if(status){set_error(status);return;}
+    r->terminal=1;
+    if(r->expiry){remove_timeout_user(r->expiry);r->expiry=NULL;}
+    pw_creation_close_fd(&r->stream);
+}
+#else
+void pw_creation_close_fd(int *fd) {if(*fd>=0){close(*fd);*fd=-1;}}
+void pw_creation_transport_error(int r,int e) {(void)r;(void)e;}
+void pw_creation_thread_dead(struct thread *t) {(void)t;}
+void pw_creation_process_dead(struct process *p) {(void)p;}
+int pw_creation_receive_fd(struct thread *t,int tag,int *fd) {(void)t;(void)tag;(void)fd;return 0;}
+unsigned int pw_creation_bind(unsigned long long g,struct process *p,unsigned int m,const void *i,unsigned int b)
+{(void)g;(void)p;(void)m;(void)i;(void)b;return STATUS_NOT_SUPPORTED;}
+unsigned int pw_creation_join(unsigned long long g,unsigned int p,unsigned int t,int n)
+{(void)g;(void)p;(void)t;(void)n;return STATUS_NOT_SUPPORTED;}
+DECL_HANDLER(creation_prepare) {set_error(STATUS_NOT_SUPPORTED);}
+DECL_HANDLER(creation_query) {set_error(STATUS_NOT_SUPPORTED);}
+DECL_HANDLER(creation_spawn) {set_error(STATUS_NOT_SUPPORTED);}
+DECL_HANDLER(creation_result) {set_error(STATUS_NOT_SUPPORTED);}
+#endif
