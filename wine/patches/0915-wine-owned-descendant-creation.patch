+#ifdef PW_WINE_SERVICE_FIXTURE
+/* Reservation-tagged transfer: one nonblocking attempt, no reuse/retry. */
+unsigned int pw_creation_send_fd(int fd,int tag,int *raw,int *error)
+{
+    struct send_fd data={GetCurrentThreadId(),tag};
+    struct iovec vec={&data,sizeof(data)};
+    union { struct cmsghdr align; unsigned char bytes[CMSG_SPACE(sizeof(int))]; } control;
+    struct msghdr msg={0};memset(&control,0,sizeof(control));
+    if(fd<0||tag>-2||tag<-(int)(PW_WINE_CREATION_REQUESTS+1)||!raw||!error)return STATUS_INVALID_PARAMETER;
+    msg.msg_iov=&vec;msg.msg_iovlen=1;msg.msg_control=control.bytes;msg.msg_controllen=sizeof(control.bytes);
+    struct cmsghdr *cmsg=&control.align;
+    cmsg->cmsg_level=SOL_SOCKET;cmsg->cmsg_type=SCM_RIGHTS;cmsg->cmsg_len=CMSG_LEN(sizeof(fd));
+    memcpy(CMSG_DATA(cmsg),&fd,sizeof(fd));
+    int rc=sendmsg(fd_socket,&msg,MSG_DONTWAIT|MSG_NOSIGNAL),err=rc<0?errno:0;
+    *raw=rc;*error=err;
+    return rc==sizeof(data)?STATUS_SUCCESS:STATUS_UNSUCCESSFUL;
+}
