+++ b/dlls/ntdll/unix/creation.c
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+#include <errno.h>
+#include <stdint.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "wine/server.h"
+#include "wine/debug.h"
+#include "unix_private.h"
+#include "creation.h"
+#ifdef PW_WINE_SERVICE_FIXTURE
+#include "wine/pw_wine_creation.h"
+#include "wine/pw_wine_fixture_socket.h"
+WINE_DEFAULT_DEBUG_CHANNEL(process);
+static _Atomic uint64_t creation_next_key;
+static uint32_t creation_clock(struct pw_creation_call *c,uint64_t *now)
+{
+    struct timespec ts;
+    if(clock_gettime(CLOCK_MONOTONIC,&ts)||ts.tv_sec<0||ts.tv_nsec<0||ts.tv_nsec>=1000000000||
+       (uint64_t)ts.tv_sec>UINT64_MAX/1000)return STATUS_UNSUCCESSFUL;
+    uint64_t ms=(uint64_t)ts.tv_sec*1000,part=(uint64_t)ts.tv_nsec/1000000;
+    if(part>UINT64_MAX-ms)return STATUS_UNSUCCESSFUL;
+    uint64_t value=ms+part;
+    if(value<c->last_clock)return STATUS_UNSUCCESSFUL;
+    c->last_clock=value;*now=value;
+    return c->deadline&&value>=c->deadline?STATUS_IO_TIMEOUT:0;
+}
+static uint32_t creation_query(struct pw_creation_call *c,unsigned int *phase)
+{
+    uint64_t now;uint32_t status=creation_clock(c,&now);
+    if(status)return status;
+    SERVER_START_REQ(creation_query)
+    {
+        req->generation=c->generation;req->lease=c->lease;req->key=c->key;
+        status=wine_server_call(req);
+        if(!status){
+            if(reply->deadline!=c->deadline)status=STATUS_INTERNAL_ERROR;
+            else if(reply->phase==PW_WCR_FAILED)status=reply->status?reply->status:STATUS_UNSUCCESSFUL;
+            else if(reply->phase>PW_WCR_BOOTSTRAPPED||reply->status)status=STATUS_INTERNAL_ERROR;
+            else *phase=reply->phase;
+        }
+    }
+    SERVER_END_REQ;
+    if(!status)status=creation_clock(c,&now);
+    return status;
+}
+static uint32_t creation_wait(struct pw_creation_call *c,unsigned int wanted)
+{
+    for(;;){
+        unsigned int phase=PW_WCR_FAILED;uint32_t status=creation_query(c,&phase);
+        if(status)return status;
+        if(phase==wanted)return 0;
+        if(phase>wanted)return STATUS_INTERNAL_ERROR;
+        uint64_t now;
+        if((status=creation_clock(c,&now)))return status;
+        uint64_t left=c->deadline-now;
+        /* Existing creation-wait cadence, capped by the original endpoint. */
+        LARGE_INTEGER delay;delay.QuadPart=-(LONGLONG)(left<10?left:10)*10000;
+        status=NtDelayExecution(FALSE,&delay);
+        if(status)return status;
+    }
+}
+unsigned int pw_creation_client_prepare(struct pw_creation_call *c,unsigned int machine,
+                                        const void *image,unsigned int bytes,const char *path)
+{
+    const PwWineCreationChild *child=pw_wine_creation_child_get();
+    uint64_t now;uint32_t status;size_t length;
+    if(!c||c->key||!child||child->profile!=2||!image||!bytes||(bytes&1)||
+       bytes>PW_WINE_CREATION_IMAGE_BYTES||!path)return STATUS_NOT_SUPPORTED;
+    length=strnlen(path,PW_WINE_CREATION_PATH_BYTES);
+    if(!length||length>=PW_WINE_CREATION_PATH_BYTES)return STATUS_NOT_SUPPORTED;
+    uint64_t old=atomic_load_explicit(&creation_next_key,memory_order_relaxed);
+    for(unsigned int attempt=0;attempt<8&&!c->key;attempt++){
+        if(old==UINT64_MAX)return STATUS_TOO_MANY_OPENED_FILES;
+        if(atomic_compare_exchange_strong_explicit(&creation_next_key,&old,old+1,
+                                                   memory_order_relaxed,memory_order_relaxed))c->key=old+1;
+    }
+    if(!c->key)return STATUS_TOO_MANY_OPENED_FILES;
+    if((status=creation_clock(c,&now)))return status;
+    if(now>UINT64_MAX-PW_WINE_CREATION_STARTUP_MS)return STATUS_UNSUCCESSFUL;
+    c->deadline=now+PW_WINE_CREATION_STARTUP_MS;
+    SERVER_START_REQ(creation_prepare)
+    {
+        req->key=c->key;req->deadline=c->deadline;req->machine=machine;
+        req->image_bytes=bytes;req->path_bytes=length+1;
+        wine_server_add_data(req,image,bytes);wine_server_add_data(req,path,length+1);
+        status=wine_server_call(req);
+        if(!status){
+            c->generation=reply->generation;c->lease=reply->lease;c->tag=reply->tag;
+            if(!c->generation||!c->lease||c->tag>-2||c->tag<-(int)(PW_WINE_CREATION_REQUESTS+1)||
+               reply->deadline>c->deadline||reply->deadline<=now)status=STATUS_INTERNAL_ERROR;
+            else c->deadline=reply->deadline;
+        }
+    }
+    SERVER_END_REQ;
+    if(status)return status;
+    return creation_wait(c,PW_WCR_ADMITTED);
+}
+unsigned int pw_creation_client_spawn(struct pw_creation_call *c,int borrowed,HANDLE process,HANDLE thread)
+{
+    uint64_t now;uint32_t status=creation_clock(c,&now);
+    if(status)return status;
+    int fd=dup(borrowed);
+    if(fd<0)return STATUS_TOO_MANY_OPENED_FILES;
+    PwWineFixtureSocketResult checked;
+    status=pw_wine_fixture_socket_prepare(fd,PW_WF_SOCKET_CLOEXEC,&checked)?STATUS_UNSUCCESSFUL:0;
+    if(!status)status=creation_clock(c,&now);
+    if(!status){
+        status=pw_creation_send_fd(fd,c->tag,&c->transfer_raw,&c->transfer_error);
+        if(status)c->transfer_uncertain=1;
+    }
+    int closed=close(fd),error=closed<0?errno:0;
+    if(closed){
+        if(!c->transfer_uncertain){c->transfer_raw=closed;c->transfer_error=error;}
+        c->transfer_uncertain=1;if(!status)status=STATUS_UNSUCCESSFUL;
+    }
+    if(status)return status;
+    if((status=creation_clock(c,&now)))return status;
+    SERVER_START_REQ(creation_spawn)
+    {
+        req->generation=c->generation;req->lease=c->lease;req->key=c->key;
+        req->process=wine_server_obj_handle(process);req->thread=wine_server_obj_handle(thread);
+        status=wine_server_call(req);
+    }
+    SERVER_END_REQ;
+    return status?status:creation_wait(c,PW_WCR_BOOTSTRAPPED);
+}
+unsigned int pw_creation_client_remaining(struct pw_creation_call *c)
+{
+    unsigned int phase;uint64_t now;
+    if(!c||!c->generation||creation_query(c,&phase)||phase!=PW_WCR_BOOTSTRAPPED||creation_clock(c,&now))return 0;
+    uint64_t left=c->deadline-now;
+    return left>PW_WINE_CREATION_STARTUP_MS?0:(unsigned int)left;
+}
+unsigned int pw_creation_client_result(struct pw_creation_call *c,unsigned int success,unsigned int status)
+{
+    unsigned int ret;
+    if(!c||!c->generation)return STATUS_INVALID_PARAMETER;
+    SERVER_START_REQ(creation_result)
+    {
+        req->generation=c->generation;req->lease=c->lease;req->key=c->key;
+        req->success=success;req->status=status;req->transfer_uncertain=c->transfer_uncertain;
+        req->transfer_raw=c->transfer_uncertain?c->transfer_raw:0;
+        req->transfer_error=c->transfer_uncertain?c->transfer_error:0;
+        ret=wine_server_call(req);
+    }
+    SERVER_END_REQ;
+    return ret; /* caller preserves its actual result, cleans local resources, then aborts if needed */
+}
+#endif
