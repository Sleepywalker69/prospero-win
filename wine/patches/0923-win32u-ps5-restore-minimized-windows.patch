Subject: win32u: restore validated local minimized roots when cycling

One same-GUI-thread restore attempt; no queued cross-process activation.

diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
index 36a676d..c88423c 100644
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -598,6 +598,18 @@ static BOOL is_extended_key( WORD vk )
     return FALSE;
 }

+static UINT64 window_input_generation( HWND hwnd )
+{
+    struct ps5_window *window;
+    UINT64 generation;
+
+    pthread_mutex_lock( &screen_lock );
+    window = find_window( hwnd );
+    generation = window ? window->generation : 0;
+    pthread_mutex_unlock( &screen_lock );
+    return generation;
+}
+
 /* A switcher snapshot contains only process-local, live registry identities.
  * It intentionally does not enumerate Wine child-process transport surfaces. */
 struct ps5_window_choice
@@ -619,35 +631,60 @@ static BOOL window_choice_live( const struct ps5_window_choice *choice )
     return live && is_window( choice->hwnd );
 }

+/* Revalidate USER state as well as registry identity at each action boundary.
+ * Restoring only a root owned by this GUI thread avoids an unbounded synchronous
+ * cross-thread ShowWindow send or a queued restore that activates much later. */
+static BOOL window_choice_eligible( const struct ps5_window_choice *choice )
+{
+    DWORD process = 0, root_process = 0, thread, style, exstyle;
+    HWND root;
+
+    if (!window_choice_live( choice ) ||
+        !(thread = NtUserGetWindowThread( choice->hwnd, &process )) ||
+        process != GetCurrentProcessId()) return FALSE;
+    style = NtUserGetWindowLongW( choice->hwnd, GWL_STYLE );
+    exstyle = NtUserGetWindowLongW( choice->hwnd, GWL_EXSTYLE );
+    if (!(style & WS_VISIBLE) || (style & (WS_DISABLED | WS_CHILD)) ||
+        (exstyle & (WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW))) return FALSE;
+    root = NtUserGetAncestor( choice->hwnd, GA_ROOTOWNER );
+    if (!root || (choice->root && root != choice->root) ||
+        !NtUserGetWindowThread( root, &root_process ) || root_process != GetCurrentProcessId()) return FALSE;
+    if ((style & WS_MINIMIZE) && (root != choice->hwnd || thread != GetCurrentThreadId())) return FALSE;
+    return TRUE;
+}
+
+static BOOL cycle_foreground_unchanged( HWND current, UINT64 generation )
+{
+    DWORD process = 0;
+
+    return current && generation && NtUserGetForegroundWindow() == current && is_window( current ) &&
+           window_input_generation( current ) == generation && NtUserGetWindowThread( current, &process ) &&
+           process == GetCurrentProcessId();
+}
