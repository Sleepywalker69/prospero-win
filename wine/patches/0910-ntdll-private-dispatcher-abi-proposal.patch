--- /dev/null
+++ b/include/wine/pw_private_dispatch.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef __WINE_PW_PRIVATE_DISPATCH_H
+#define __WINE_PW_PRIVATE_DISPATCH_H
+
+/* ABI1 is selected at build time, per Wine runtime, never by a profile or
+ * by the parent process's machine. All constants describe this process. */
+#define PW_PRIVATE_DISPATCH_ABI 1
+#define PW_PRIVATE_DISPATCH_USD 0x7ffe0000
+#define PW_PRIVATE_DISPATCH_SLOT 0x7ffe4000
+#define PW_PRIVATE_DISPATCH_PAGE 0x4000
+#define PW_PRIVATE_DISPATCH_SPAN 0x8000
+#define PW_PRIVATE_DISPATCH_STRING_(value) #value
+#define PW_PRIVATE_DISPATCH_STRING(value) PW_PRIVATE_DISPATCH_STRING_(value)
+
+#if !defined(__x86_64__) || defined(__arm64ec__) || defined(__arm64ec_x64__)
+#error The private dispatcher ABI supports native AMD64 only
+#endif
+
+/* Pure byte contract. No guest addresses are dereferenced by this helper.
+ * The syscall number at bytes4..7 is deliberately unconstrained. */
+static inline int pw_private_dispatch_thunk_valid(const unsigned char *code, unsigned long size)
+{
+    static const unsigned char prefix[4] = {0x4c,0x8b,0xd1,0xb8};
+    static const unsigned char middle[19] = {
+        0xf6,0x04,0x25,0x08,0x03,0xfe,0x7f,0x01,0x75,0x03,
+        0x0f,0x05,0xc3,0xeb,0x01,0xc3,0xff,0x14,0x25
+    };
+    unsigned int i, slot;
+    if (!code || size < 32) return 0;
+    for (i = 0; i < 4; i++) if (code[i] != prefix[i]) return 0;
+    for (i = 0; i < 19; i++) if (code[8 + i] != middle[i]) return 0;
+    slot = code[27] | ((unsigned int)code[28] << 8) |
+           ((unsigned int)code[29] << 16) | ((unsigned int)code[30] << 24);
+    return slot == PW_PRIVATE_DISPATCH_SLOT && code[31] == 0xc3;
+}
+
+static inline unsigned int pw_pd_u16(const unsigned char *p)
+{
+    return p[0] | ((unsigned int)p[1] << 8);
+}
+
+static inline unsigned int pw_pd_u32(const unsigned char *p)
+{
+    return pw_pd_u16(p) | (pw_pd_u16(p + 2) << 16);
+}
+
+struct pw_pd_image
+{
+    const unsigned char *bytes;
+    unsigned long size;
+    unsigned int headers, sections, section_count;
+};
+
+/* Bounds plus declared readable mapped coverage: reject section gaps and
+ * execute-only/unreadable sections rather than treating SizeOfImage as one
+ * readable allocation. Header/section-table bounds are established first. */
+static inline int pw_pd_readable(const struct pw_pd_image *image,
+                                 unsigned int rva, unsigned int length)
+{
+    unsigned int i;
+    if (!length || rva >= image->size || length > image->size - rva) return 0;
+    if (rva < image->headers && length <= image->headers - rva) return 1;
+    for (i = 0; i < image->section_count; i++)
+    {
+        const unsigned char *section = image->bytes + image->sections + 40 * i;
+        unsigned int start = pw_pd_u32(section + 12), span = pw_pd_u32(section + 8);
+        if (!(pw_pd_u32(section + 36) & 0x40000000)) continue;
+        if (start <= rva && rva - start < span && length <= span - (rva - start)) return 1;
+    }
+    return 0;
+}
+
+/* Pure mapped-image validation. No PE routine is called, and every new
+ * export-directory/table/name/thunk access is checked before it is read. */
+static inline int pw_private_dispatch_image_valid(const unsigned char *bytes,
+                                                   unsigned long size, const char *anchor)
+{
+    struct pw_pd_image image;
+    unsigned int pe, optional, optional_size, directory, directory_size;
+    unsigned int functions, names, function_table, name_table, ordinal_table, i, found = 0;
+    unsigned long limit;
+    if (!bytes || !anchor || size < 64 || bytes[0] != 'M' || bytes[1] != 'Z') return 0;
+    /* Wine's already mapped header page is readable; stay inside that page
+     * while establishing the full header/section description. */
+    limit = size < 0x1000 ? size : 0x1000;
+    pe = pw_pd_u32(bytes + 60);
+    if (pe > limit || limit - pe < 24 || pw_pd_u32(bytes + pe) != 0x00004550) return 0;
+    if (pw_pd_u16(bytes + pe + 4) != 0x8664) return 0;
+    image.section_count = pw_pd_u16(bytes + pe + 6);
+    optional_size = pw_pd_u16(bytes + pe + 20);
+    optional = pe + 24;
+    if (!image.section_count || image.section_count > 96 || optional_size < 120 ||
+        optional_size > limit - optional || pw_pd_u16(bytes + optional) != 0x20b) return 0;
+    image.bytes = bytes;
+    image.size = pw_pd_u32(bytes + optional + 56);
+    image.headers = pw_pd_u32(bytes + optional + 60);
+    image.sections = optional + optional_size;
+    if (image.size > size || image.headers > limit || image.headers > image.size ||
+        image.sections > image.headers || image.section_count * 40 > image.headers - image.sections ||
+        pw_pd_u32(bytes + optional + 108) < 1) return 0;
+    for (i = 0; i < image.section_count; i++)
+    {
+        const unsigned char *section = bytes + image.sections + 40 * i;
+        unsigned int start = pw_pd_u32(section + 12), span = pw_pd_u32(section + 8);
+        unsigned int j;
+        if (start > image.size || span > image.size - start || (span && start < image.headers)) return 0;
+        for (j = 0; span && j < i; j++)
+        {
+            const unsigned char *prior = bytes + image.sections + 40 * j;
+            unsigned int old_start = pw_pd_u32(prior + 12), old_span = pw_pd_u32(prior + 8);
+            if (old_span && start < old_start + old_span && old_start < start + span) return 0;
+        }
+    }
+    directory = pw_pd_u32(bytes + optional + 112);
+    directory_size = pw_pd_u32(bytes + optional + 116);
+    if (!directory || directory_size < 40 || !pw_pd_readable(&image, directory, directory_size)) return 0;
+    functions = pw_pd_u32(bytes + directory + 20);
+    names = pw_pd_u32(bytes + directory + 24);
+    function_table = pw_pd_u32(bytes + directory + 28);
+    name_table = pw_pd_u32(bytes + directory + 32);
+    ordinal_table = pw_pd_u32(bytes + directory + 36);
+    if (!functions || functions > 65536 || !names || names > 65536 ||
+        !function_table || !name_table || !ordinal_table ||
+        !pw_pd_readable(&image, function_table, functions * 4) ||
+        !pw_pd_readable(&image, name_table, names * 4) ||
+        !pw_pd_readable(&image, ordinal_table, names * 2)) return 0;
+    for (i = 0; i < names; i++)
+    {
+        unsigned int name = pw_pd_u32(bytes + name_table + i * 4);
+        unsigned int ordinal = pw_pd_u16(bytes + ordinal_table + i * 2);
+        unsigned int length, equal = 1, function;
+        if (ordinal >= functions) return 0;
+        for (length = 0; length < 512; length++)
+        {
+            unsigned char value;
+            if (name > 0xffffffffu - length || !pw_pd_readable(&image, name + length, 1)) return 0;
+            value = bytes[name + length];
+            if (equal && value != (unsigned char)anchor[length]) equal = 0;
+            if (!value) break;
+        }
+        if (length == 512) return 0;
+        function = pw_pd_u32(bytes + function_table + ordinal * 4);
+        if (function && !pw_pd_readable(&image, function, 1)) return 0;
+        if (!equal) continue;
+        if (found++ || !pw_pd_readable(&image, function, 32) ||
+            (function >= directory && function - directory < directory_size) ||
+            !pw_private_dispatch_thunk_valid(bytes + function, 32)) return 0;
+    }
+    return found == 1;
+}
+
+/* A successful adopt return alone is insufficient: the old adapter records
+ * release failures in stats and can still return zero. This is detection,
+ * not allocator rollback or proof of native cleanup after failure. */
+static inline int pw_private_dispatch_adoption_valid(int status,
+        unsigned long long failures_before, unsigned long long failures_after,
+        unsigned long usd_backed_after, unsigned long private_backed_after)
+{
+    return !status && failures_before == failures_after && !usd_backed_after &&
+           private_backed_after == PW_PRIVATE_DISPATCH_PAGE;
+}
+#endif
