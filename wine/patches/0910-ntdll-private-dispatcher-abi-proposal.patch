+#if defined(WINE_PS5_PRIVATE_DISPATCH) && WINE_PS5_PRIVATE_DISPATCH
+static const char *private_dispatch_anchor( const UNICODE_STRING *name )
+{
+    static const WCHAR ntdll[] = {'n','t','d','l','l','.','d','l','l'};
+    static const WCHAR win32u[] = {'w','i','n','3','2','u','.','d','l','l'};
+    const WCHAR *base = name->Buffer;
+    unsigned int i, count = name->Length / sizeof(WCHAR);
+    for (i = 0; i < count; i++)
+        if (name->Buffer[i] == '\\' || name->Buffer[i] == '/') base = name->Buffer + i + 1;
+    count -= base - name->Buffer;
+    if (count == ARRAY_SIZE(ntdll) && !wcsnicmp( base, ntdll, count )) return "NtClose";
+    if (count == ARRAY_SIZE(win32u) && !wcsnicmp( base, win32u, count )) return "NtUserGetThreadState";
+    return NULL;
+}
