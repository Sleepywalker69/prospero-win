+NTSTATUS pw_private_dispatch_validate_module( void *module, SIZE_T size, const UNICODE_STRING *name )
+{
+    const char *anchor;
+
+    if (!name || !name->Buffer || !name->Length || name->Length % sizeof(WCHAR))
+        return STATUS_INVALID_IMAGE_FORMAT;
+    anchor = private_dispatch_anchor( name );
+    if (!anchor) return STATUS_SUCCESS;
+    if (!pw_private_dispatch_image_valid( module, size, anchor ))
+    {
+        ERR( "private dispatcher ABI1 mismatch in %s (%s)\n", debugstr_us(name), anchor );
+        return STATUS_INVALID_IMAGE_FORMAT;
+    }
+    return STATUS_SUCCESS;
+}
