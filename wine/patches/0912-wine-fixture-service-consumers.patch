@@ -2163,9 +2193,69 @@
  *
  * Close server socket and exit process normally.
  */
+#ifdef PW_WINE_SERVICE_FIXTURE
+/* Ordinary root exit only. First freeze admission, then detach the real
+ * Wine client through normal server requests and HUP cleanup. Windows parent
+ * death can therefore unblock a child while the native host remains alive. */
+void pw_wine_fixture_root_exit( unsigned int windows_status )
+{
+    const PwWineFixtureProvider *fixture = pw_wine_fixture_get();
+    struct thread_data *data = get_thread_data();
+    unsigned int status = 0;
+    int self = 0, failed_close = 0, close_error = 0;
+    int *slots[6] = { &data->alert_fd, &data->wait_fd[0], &data->wait_fd[1],
+                      &data->reply_fd, &data->request_fd, &fd_socket };
+    unsigned int i, j;
+    if (!fixture) return;
+    fixture->root_exit( fixture->context, windows_status ); /* freeze first */
+    SERVER_START_REQ( terminate_process )
+    {
+        req->handle = 0;
+        req->exit_code = windows_status;
+        status = wine_server_call( req );
+        self = reply->self;
+    }
+    SERVER_END_REQ;
+    if (!status && self)
+    {
+        SERVER_START_REQ( terminate_thread )
+        {
+            req->handle = wine_server_obj_handle( NtCurrentThread() );
+            req->exit_code = windows_status;
+            status = wine_server_call( req );
+            self = reply->self;
+        }
+        SERVER_END_REQ;
+    }
+    if (!status && self)
+    {
+        extern void unregister_inprocess_thread(void);
+        unregister_inprocess_thread();
+        /* Never issue another Wine request after detachment. Clearing slots
+         * before close also prevents the ordinary wrapper from closing a
+         * reused number. Unexpected duplicate slots close only once. */
+        for (i = 0; i < 6; ++i)
+        {
+            int fd = *slots[i], rc;
+            *slots[i] = -1;
+            if (fd < 0) continue;
+            for (j = i + 1; j < 6; ++j) if (*slots[j] == fd) *slots[j] = -1;
+            rc = close( fd );
+            if (rc && !failed_close) { failed_close = rc; close_error = rc < 0 ? errno : 0; }
+        }
+    }
+    fixture->root_detached( fixture->context, !status && self && !failed_close,
+                            status ? (int)status : failed_close, close_error );
+    while (!fixture->root_exit( fixture->context, windows_status )) usleep(10000);
+}
+#endif
 void process_exit_wrapper( int status )
 {
+#ifdef PW_WINE_SERVICE_FIXTURE
+    if (fd_socket != -1) close( fd_socket );
+#else
     close( fd_socket );
+#endif
     exit( status );
 }
 
