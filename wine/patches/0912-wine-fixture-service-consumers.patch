@@ -893,20 +916,50 @@
 
     /* create the child process */
 
-    if ((status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info ))) goto done;
+#ifdef PW_WINE_SERVICE_FIXTURE
+    status = fixture->spawn( fixture->context, fixture_generation, socketfd[0], process_id, thread_id );
+#else
+    status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info );
+#endif
+    if (status) goto done;
 
     close( socketfd[0] );
     socketfd[0] = -1;
 
     /* wait for the new process info to be ready */
 
+#ifdef PW_WINE_SERVICE_FIXTURE
+    {
+        LARGE_INTEGER timeout;
+        ULONG remaining = fixture->startup_remaining_ms( fixture->context, fixture_generation );
+        if (!remaining || remaining > 30000) { status = STATUS_IO_TIMEOUT; goto done; }
