+        status = NtWaitForSingleObject( process_info, FALSE, &timeout );
+        if (status != STATUS_WAIT_0)
+        {
+            if (status == STATUS_TIMEOUT) status = STATUS_IO_TIMEOUT;
+            goto done;
+        }
+        if (!fixture->startup_remaining_ms( fixture->context, fixture_generation ))
+        { status = STATUS_IO_TIMEOUT; goto done; }
